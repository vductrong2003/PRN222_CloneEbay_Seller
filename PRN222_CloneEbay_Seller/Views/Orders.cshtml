@model List<PRN222_CloneEbay_Seller.Models.OrderTable>
@{
    ViewData["Title"] = "Orders";
    string currentStatus = ViewBag.CurrentStatus ?? "all";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs với Dropdown Menu -->
            <div class="tabs-container">
                <a href="/Seller/Overview" class="tab">Overview</a>

                <!-- Tab Orders có dropdown - Active -->
                <div class="tab-wrapper">
                    <a href="/Seller/Orders" class="tab has-dropdown active">Orders</a>
                    <div class="dropdown-menu">
                        <a href="/Seller/Orders?status=all" class="dropdown-item @(currentStatus == "all" ? "active" : "")">All orders</a>
                        <a href="/Seller/Orders?status=awaiting-payment" class="dropdown-item @(currentStatus == "awaiting-payment" ? "active" : "")">Awaiting payment</a>
                        <a href="/Seller/Orders?status=awaiting-shipment" class="dropdown-item @(currentStatus == "awaiting-shipment" ? "active" : "")">Awaiting shipment</a>
                        <a href="/Seller/Orders?status=shipped" class="dropdown-item @(currentStatus == "shipped" ? "active" : "")">Paid and shipped</a>
                        <a href="/Seller/Orders?status=cancelled" class="dropdown-item @(currentStatus == "cancelled" ? "active" : "")">Cancellations</a>
                        <a href="/Seller/Orders?status=returns" class="dropdown-item">Returns</a>
                        <a href="#" class="dropdown-item">Requests and disputes</a>
                        <a href="#" class="dropdown-item">Shipping labels</a>
                    </div>
                </div>

                <!-- Tab Listings có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Listings</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Create listing</a>
                        <a href="#" class="dropdown-item">Active</a>
                        <a href="#" class="dropdown-item">Unsold</a>
                        <a href="#" class="dropdown-item">Drafts</a>
                        <a href="#" class="dropdown-item">Scheduled</a>
                        <a href="#" class="dropdown-item">Ended</a>
                    </div>
                </div>

                <!-- Tab Marketing có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                        <a href="#" class="dropdown-item">Email marketing</a>
                    </div>
                </div>

                <a href="/Seller/Store" class="tab">Store</a>

                <div class="tab-wrapper">
                    <a href="/Seller/Performance" class="tab has-dropdown">Performance</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Summary</a>
                        <a href="#" class="dropdown-item">Seller level</a>
                        <a href="#" class="dropdown-item">Sales</a>
                        <a href="#" class="dropdown-item">Traffic</a>
                    </div>
                </div>

                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                        <a href="#" class="dropdown-item">Transaction history</a>
                    </div>
                </div>

                <a href="#" class="tab">Research</a>

                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                        <a href="#" class="dropdown-item">Performance reports</a>
                    </div>
                </div>

                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        <!-- Orders Page Content -->
        <div class="page-title">
            Orders
            @{
                string statusText = currentStatus switch
                {
                    "awaiting-payment" => " - Awaiting Payment",
                    "awaiting-shipment" => " - Awaiting Shipment", 
                    "shipped" => " - Shipped",
                    "completed" => " - Completed",
                    "cancelled" => " - Cancelled",
                    _ => " - All Orders"
                };
            }
            <span style="font-weight: normal; color: #767676;">@statusText</span>
        </div>

        <!-- Orders Summary Cards -->
        <div class="cards-grid">
            <div class="overview-card">
                <div class="overview-card-title">Total Orders</div>
                <div class="overview-card-value">@Model.Count</div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Awaiting Payment</div>
                <div class="overview-card-value">@Model.Count(o => o.Status == "Pending")</div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Awaiting Shipment</div>
                <div class="overview-card-value">@Model.Count(o => o.Status == "Paid")</div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Total Revenue</div>
                <div class="overview-card-value">$@Model.Sum(o => o.TotalPrice ?? 0).ToString("N2")</div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="panel">
            <div class="panel-header">
                <h3 class="panel-title">Order List</h3>
                <div class="panel-stats">
                    <span class="panel-stats-number">@Model.Count</span>
                    orders
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="orders-table">
                    <div class="orders-table-header">
                        <div class="order-col-id">Order ID</div>
                        <div class="order-col-buyer">Buyer</div>
                        <div class="order-col-items">Items</div>
                        <div class="order-col-total">Total</div>
                        <div class="order-col-status">Status</div>
                        <div class="order-col-date">Order Date</div>
                        <div class="order-col-actions">Actions</div>
                    </div>

                    @foreach (var order in Model)
                    {
                        <div class="order-row">
                            <div class="order-col-id">
                                <strong>#@order.Id</strong>
                            </div>
                            <div class="order-col-buyer">
                                <div class="buyer-info">
                                    <div class="buyer-name">@(order.Buyer?.Username ?? "Unknown")</div>
                                    <div class="buyer-email">@(order.Buyer?.Email ?? "")</div>
                                </div>
                            </div>
                            <div class="order-col-items">
                                @if (order.OrderItems.Any())
                                {
                                    <div class="order-items-list">
                                        @foreach (var item in order.OrderItems.Take(2))
                                        {
                                            <div class="order-item">
                                                <span class="item-name">@(item.Product?.Title ?? "Unknown Product")</span>
                                                <span class="item-qty">x@item.Quantity</span>
                                            </div>
                                        }
                                        @if (order.OrderItems.Count > 2)
                                        {
                                            <div class="more-items">+@(order.OrderItems.Count - 2) more items</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="order-col-total">
                                <strong>$@(order.TotalPrice?.ToString("N2") ?? "0.00")</strong>
                            </div>
                            <div class="order-col-status">
                                <span class="status-badge status-@(order.Status?.ToLower() ?? "unknown")">
                                    @(order.Status ?? "Unknown")
                                </span>
                            </div>
                            <div class="order-col-date">
                                @order.OrderDate?.ToString("MMM dd, yyyy")
                            </div>
                            <div class="order-col-actions">
                                <div class="action-buttons">
                                    <a href="#" class="action-btn">View</a>
                                    @if (order.Status == "Paid")
                                    {
                                        <a href="#" class="action-btn btn-ship">Ship</a>
                                    }
                                    @if (order.Status == "Pending")
                                    {
                                        <a href="#" class="action-btn btn-cancel">Cancel</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">📦</div>
                    <div class="empty-title">No orders found</div>
                    <div class="empty-message">
                        @{
                            string emptyMessage = currentStatus switch
                            {
                                "awaiting-payment" => "You don't have any orders awaiting payment at the moment.",
                                "awaiting-shipment" => "You don't have any orders awaiting shipment at the moment.",
                                "shipped" => "You don't have any shipped orders at the moment.",
                                "completed" => "You don't have any completed orders at the moment.",
                                "cancelled" => "You don't have any cancelled orders at the moment.",
                                _ => "You don't have any orders yet. Start selling to see your orders here!"
                            };
                        }
                        @emptyMessage
                    </div>
                </div>
            }
        </div>
    </div>

    <footer>
        <p>&copy; 2024 eBay Clone. All rights reserved.</p>
    </footer>
</body>
</html>