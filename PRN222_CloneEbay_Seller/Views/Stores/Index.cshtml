@model PRN222_CloneEbay_Seller.Models.Store
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.StoreName) ? $"{Model.StoreName} - My Store" : "My Store";
    var statistics = ViewBag.Statistics as Dictionary<string, object> ?? new Dictionary<string, object>();
    var products = ViewBag.Products as List<PRN222_CloneEbay_Seller.Models.Product> ?? new List<PRN222_CloneEbay_Seller.Models.Product>();
    var isEditMode = ViewBag.IsEditMode ?? false;
    var isNewStore = ViewBag.IsNewStore ?? false;
    var userEmail = Context.Session.GetString("Email") ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css" />
    
</head>
<body>
    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs -->
            <div class="tabs-container">
                <a href="/Seller/Overview" class="tab">Overview</a>

                <!-- Tab Orders có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Orders" class="tab has-dropdown">Orders</a>
                    <div class="dropdown-menu">
                        <a href="/Orders?status=all" class="dropdown-item">All orders</a>
                        <a href="/Orders?status=awaiting-payment" class="dropdown-item">Awaiting payment</a>
                        <a href="/Orders?status=awaiting-shipment" class="dropdown-item">Awaiting shipment</a>
                        <a href="/Orders?status=shipped" class="dropdown-item">Paid and shipped</a>
                        <a href="/Orders?status=cancelled" class="dropdown-item">Cancellations</a>
                        <a href="/Orders/Returns" class="dropdown-item">Returns</a>
                        <a href="/Orders/Disputes" class="dropdown-item">Requests and disputes</a>
                        <a href="/Orders/ShippingLabels" class="dropdown-item">Shipping labels</a>
                    </div>
                </div>

                <!-- Tab Listings có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Listing" class="tab has-dropdown">Listings</a>
                    <div class="dropdown-menu">
                        <a href="/Listing/Create" class="dropdown-item">Create listing</a>
                        <a href="/Listing?status=active" class="dropdown-item">Active</a>
                        <a href="/Listing?status=inactive" class="dropdown-item">Inactive</a>
                        <a href="/Listing?status=draft" class="dropdown-item">Drafts</a>
                        <a href="/Listing?status=scheduled" class="dropdown-item">Scheduled</a>
                    </div>
                </div>

                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                        <a href="#" class="dropdown-item">Email marketing</a>
                    </div>
                </div>

                <!-- Tab Store - Active -->
                <a href="/Stores" class="tab active">Store</a>

                <!-- Tab Performance có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Performance" class="tab has-dropdown">Performance</a>
                    <div class="dropdown-menu">
                        <a href="/Performance" class="dropdown-item">Overview</a>
                        <a href="/Performance/Dashboard" class="dropdown-item">Dashboard</a>
                        <a href="/Performance/Sales" class="dropdown-item">Sales</a>
                        <a href="/Performance/Analytics" class="dropdown-item">Analytics</a>
                        <a href="/Performance/Products" class="dropdown-item">Products</a>
                    </div>
                </div>

                <!-- Tab Payments có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                        <a href="#" class="dropdown-item">Transaction history</a>
                    </div>
                </div>

                <!-- Tab thông thường khác -->
                <a href="#" class="tab">Research</a>

                <!-- Tab Reports có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                        <a href="#" class="dropdown-item">Performance reports</a>
                    </div>
                </div>

                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        

        <!-- Status Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="status-message status-success">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="status-message status-error">
                @TempData["Error"]
            </div>
        }

        

        @if (isNewStore)
        {
            <!-- New Store Creation State -->
            <div class="empty-store-state">
                <div class="empty-store-icon">🏪</div>
                <div class="empty-store-title">Welcome to Your Store</div>
                <div class="empty-store-message">
                    You don't have a store yet. Create your store to start selling and showcase your products to customers.
                </div>
                <a href="@Url.Action("Edit")" class="btn btn-primary">
                    <span class="btn-icon">✨</span>
                    Create My Store
                </a>
            </div>
        }
        else if (isEditMode)
        {
            <!-- Edit Mode -->
            <div class="store-edit-form">
                <form asp-action="Save" method="post" enctype="multipart/form-data">
                    @if (!isNewStore)
                    {
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SellerId" />
                    }
                    
                    <div class="form-section">
                        <h3>Basic Information</h3>
                        
                        <div class="form-group">
                            <label asp-for="StoreName">Store Name *</label>
                            <input asp-for="StoreName" class="form-control" placeholder="Enter your store name" required />
                            <span asp-validation-for="StoreName" class="invalid-feedback"></span>
                            <div class="form-help">Choose a unique name that represents your brand</div>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Description">Store Description</label>
                            <textarea asp-for="Description" class="form-control" 
                                      placeholder="Tell customers about your store, what you sell, and what makes you special..."></textarea>
                            <span asp-validation-for="Description" class="invalid-feedback"></span>
                            <div class="form-help">Describe your store to help customers understand what you offer</div>
                        </div>
                    </div>
                    
                    <div class="form-section">
                        <h3>Store Banner</h3>
                        
                        <div class="form-group">
                            <label for="bannerFile">Banner Image</label>
                            
                            <!-- Upload Options Tabs -->
                            <div class="upload-tabs">
                                <button type="button" class="upload-tab active" onclick="switchUploadTab('file')">
                                    📁 Upload File
                                </button>
                                <button type="button" class="upload-tab" onclick="switchUploadTab('url')">
                                    🔗 Import from URL
                                </button>
                            </div>
                            
                            <!-- File Upload Tab -->
                            <div id="fileUploadTab" class="upload-tab-content active">
                                <div class="file-upload-area" onclick="document.getElementById('bannerFile').click()">
                                    <div class="file-upload-icon">🖼️</div>
                                    <div class="file-upload-text">
                                        Click to upload banner image<br>
                                        <small>Recommended size: 1200x400px, Max 5MB</small>
                                    </div>
                                </div>
                                <input type="file" id="bannerFile" name="bannerFile" accept="image/*" style="display: none;" />
                            </div>
                            
                            <!-- URL Upload Tab -->
                            <div id="urlUploadTab" class="upload-tab-content" style="display: none;">
                                <div class="url-upload-section">
                                    <input type="url" id="bannerUrl" class="form-control" 
                                           placeholder="https://example.com/banner-image.jpg" 
                                           onblur="previewImageFromUrl()" />
                                    <button type="button" class="btn btn-outline btn-sm" onclick="previewImageFromUrl()">
                                        👁️ Preview
                                    </button>
                                </div>
                                <div class="form-help">Enter a direct link to an image (JPG, PNG, GIF)</div>
                            </div>
                            
                            <span asp-validation-for="BannerImageUrl" class="invalid-feedback"></span>
                            
                            <!-- Current Banner Preview -->
                            @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                            {
                                <div class="current-banner-preview">
                                    <p><strong>Current Banner:</strong></p>
                                    <div class="banner-preview-container">
                                        <img src="@Model.BannerImageUrl" alt="Current banner" class="banner-preview-image" id="currentBannerPreview" />
                                        <button type="button" class="btn btn-danger btn-sm remove-banner-btn" onclick="removeBanner()">
                                            🗑️ Remove
                                        </button>
                                    </div>
                                </div>
                            }
                            
                            <!-- New Image Preview -->
                            <div id="newImagePreview" class="new-image-preview" style="display: none;">
                                <p><strong>New Banner Preview:</strong></p>
                                <div class="banner-preview-container">
                                    <img id="previewImage" class="banner-preview-image" />
                                    <button type="button" class="btn btn-secondary btn-sm" onclick="clearPreview()">
                                        ❌ Clear
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Hidden field for URL import -->
                            <input type="hidden" id="bannerUrlInput" name="bannerUrl" />
                        </div>
                    </div>
                    
                    <div class="form-section">
                        <h3>Contact Information</h3>
                        <div class="form-help">
                            <strong>Contact Email:</strong> @userEmail<br>
                            <small>Customers will use this email for inquiries. You can change this in your account settings.</small>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <span class="btn-icon">❌</span>
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <span class="btn-icon">💾</span>
                            @(isNewStore ? "Create Store" : "Save Changes")
                        </button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <!-- View Mode -->
            <div class="store-header">
                <div class="store-banner-section" style="width : 100%">
                    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                    {
                        <img src="@Model.BannerImageUrl" alt="@Model.StoreName banner" class="store-banner-full" />
                    }
                    else
                    {
                        <div class="store-banner-placeholder-full">
                            <span class="store-icon-large">🏪</span>
                            <p class="banner-placeholder-text">@Model.StoreName</p>
                        </div>
                    }
                    
                    <div class="store-overlay">
                        <div class="store-title-section">
                            <h1 class="store-title">@Model.StoreName</h1>
                            <div class="store-meta">
                                @if (Model.Id > 0)
                                {
                                    <span class="store-id">Store ID: #@Model.Id</span>
                                }
                                <span class="store-status-badge active">Active</span>
                            </div>
                        </div>
                        
                        <div class="store-actions-header">
                            <a href="@Url.Action("Edit")" class="btn btn-primary">
                                <span class="btn-icon">✏️</span>
                                Edit Store
                            </a>
                            
                        </div>
                    </div>
                </div>
            </div>

            <!-- Store Content Grid -->
            <div class="store-content-grid">
                <!-- Left Column: Store Info -->
                <div class="store-main-content">
                    <!-- Store Description -->
                    <div class="panel">
                        <div class="panel-header">
                            <h3 class="panel-title">Store Description</h3>
                            <a href="@Url.Action("Edit")" class="btn btn-outline btn-sm">
                                <span class="btn-icon">✏️</span>
                                Edit
                            </a>
                        </div>
                        <div class="panel-body">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <p style="padding: 1.25rem; margin: 0; line-height: 1.6;">@Model.Description</p>
                            }
                            else
                            {
                                <div style="text-align: center; padding: 2.5rem 1.25rem; color: #666;">
                                    <span style="font-size: 3rem; display: block; margin-bottom: 1rem; opacity: 0.5;">📝</span>
                                    <p style="margin: 0 0 1.5rem 0;">No description provided. Add a description to help customers learn about your store.</p>
                                    <a href="@Url.Action("Edit")" class="btn btn-outline">Add Description</a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Store Contact Info -->
                    <div class="panel">
                        <div class="panel-header">
                            <h3 class="panel-title">Contact Information</h3>
                        </div>
                        <div style="padding: 1.25rem;">
                            <p style="margin: 0; color: #666;">
                                <strong>Email:</strong> @userEmail<br>
                                <small>This is your primary contact email for customer inquiries.</small>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Statistics -->
                <div class="store-sidebar" style="
    width: 100%;
    ">
                    <!-- Store Statistics -->
                    <div class="panel">
                        <div class="panel-header">
                            <h3 class="panel-title">Store Performance</h3>
                        </div>
                        
                        <div class="stats-grid">
                            <div class="stat-card">
                                <div class="stat-icon" style="color: #8B4513;">📦</div>
                                <div class="stat-value">@(statistics.GetValueOrDefault("TotalProducts", 0))</div>
                                <div class="stat-label">Total Products</div>
                            </div>
                            
                            <div class="stat-card">
                                <div class="stat-icon" style="color: #28a745;">✅</div>
                                <div class="stat-value">@(statistics.GetValueOrDefault("ActiveProducts", 0))</div>
                                <div class="stat-label">Active Products</div>
                            </div>
                            
                            <div class="stat-card">
                                <div class="stat-icon" style="color: #6c757d;">🛒</div>
                                <div class="stat-value">@(statistics.GetValueOrDefault("TotalOrders", 0))</div>
                                <div class="stat-label">Total Orders</div>
                            </div>
                            
                            <div class="stat-card">
                                <div class="stat-icon" style="color: #fd7e14;">💰</div>
                                <div class="stat-value">$@(Convert.ToDecimal(statistics.GetValueOrDefault("TotalRevenue", 0)).ToString("N0"))</div>
                                <div class="stat-label">Total Revenue</div>
                            </div>
                            
                            <div class="stat-card">
                                <div class="stat-icon" style="color: #ffc107;">⭐</div>
                                <div class="stat-value">@(statistics.GetValueOrDefault("AverageRating", 0))</div>
                                <div class="stat-label">Avg Rating</div>
                            </div>
                            
                            <div class="stat-card">
                                <div class="stat-icon" style="color: #6f42c1;">📝</div>
                                <div class="stat-value">@(statistics.GetValueOrDefault("TotalReviews", 0))</div>
                                <div class="stat-label">Reviews</div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="panel">
                        <div class="panel-header">
                            <h3 class="panel-title">Quick Actions</h3>
                        </div>
                        <div style="padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
                            <a href="/Listing" class="btn btn-outline">
                                <span class="btn-icon">📦</span>
                                Manage Products
                            </a>
                            <a href="/Orders" class="btn btn-outline">
                                <span class="btn-icon">🛒</span>
                                View Orders
                            </a>
                            <a href="/Performance" class="btn btn-outline">
                                <span class="btn-icon">📊</span>
                                View Analytics
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); align-items: center; justify-content: center;">
        <div style="background-color: white; border-radius: 8px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15); width: 90%; max-width: 500px;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid #e5e5e5;">
                <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: #111;">Delete Store</h3>
                <span onclick="closeModal('deleteModal')" style="color: #999; font-size: 1.5rem; font-weight: bold; cursor: pointer; line-height: 1;">&times;</span>
            </div>
            <div style="text-align: center; padding: 1.5rem;">
                <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
                <p>Are you sure you want to delete your store "<span id="storeNameToDelete"></span>"?</p>
                <p style="color: #dc3545; font-size: 0.875rem; font-weight: 500; margin-top: 0.5rem;">This action cannot be undone. All store data will be permanently deleted.</p>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; padding: 1rem 1.5rem; border-top: 1px solid #e1e1e1;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete Store</button>
            </div>
        </div>
    </div>

    <script>
        function confirmDeleteStore(storeName) {
            document.getElementById('storeNameToDelete').textContent = storeName;
            document.getElementById('confirmDeleteBtn').onclick = function() {
                deleteStore();
            };
            document.getElementById('deleteModal').style.display = 'flex';
        }

        async function deleteStore() {
            try {
                const response = await fetch('/Stores/Delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });

                const result = await response.json();
                
                if (result.success) {
                    window.location.reload();
                } else {
                    alert(result.message || 'Failed to delete store');
                }
            } catch (error) {
                console.error('Error deleting store:', error);
                alert('An error occurred while deleting the store');
            }
            
            closeModal('deleteModal');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.id === 'deleteModal') {
                event.target.style.display = 'none';
            }
        }

        // File upload preview
        document.getElementById('bannerFile')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const uploadArea = document.querySelector('.file-upload-area');
                uploadArea.querySelector('.file-upload-text').innerHTML = 
                    `Selected: ${file.name}<br><small>Click to change</small>`;
                
                // Show file preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('previewImage');
                    preview.src = e.target.result;
                    document.getElementById('newImagePreview').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        // Switch upload tab
        function switchUploadTab(tab) {
            // Clear previews when switching tabs
            clearPreview();
            
            if (tab === 'file') {
                document.getElementById('fileUploadTab').style.display = 'block';
                document.getElementById('urlUploadTab').style.display = 'none';
                document.querySelector('.upload-tab.active').classList.remove('active');
                document.querySelector('.upload-tab:nth-child(1)').classList.add('active');
            } else {
                document.getElementById('fileUploadTab').style.display = 'none';
                document.getElementById('urlUploadTab').style.display = 'block';
                document.querySelector('.upload-tab.active').classList.remove('active');
                document.querySelector('.upload-tab:nth-child(2)').classList.add('active');
            }
        }

        // Preview image from URL
        function previewImageFromUrl() {
            const url = document.getElementById('bannerUrl').value;
            const preview = document.getElementById('previewImage');
            
            if (url) {
                // Validate URL format
                try {
                    new URL(url);
                } catch {
                    alert('Please enter a valid URL');
                    return;
                }
                
                // Test if image loads
                const testImg = new Image();
                testImg.onload = function() {
                    preview.src = url;
                    document.getElementById('newImagePreview').style.display = 'block';
                    document.getElementById('bannerUrlInput').value = url; // Set hidden field
                };
                testImg.onerror = function() {
                    alert('Could not load image from this URL. Please check the URL and try again.');
                };
                testImg.src = url;
            } else {
                clearPreview();
            }
        }

        // Clear new image preview
        function clearPreview() {
            document.getElementById('previewImage').src = '';
            document.getElementById('newImagePreview').style.display = 'none';
            document.getElementById('bannerUrl').value = '';
            document.getElementById('bannerUrlInput').value = '';
            
            // Reset file input
            document.getElementById('bannerFile').value = '';
            const uploadArea = document.querySelector('.file-upload-area');
            if (uploadArea) {
                uploadArea.querySelector('.file-upload-text').innerHTML = 
                    'Click to upload banner image<br><small>Recommended size: 1200x400px, Max 5MB</small>';
            }
        }

        // Remove banner image
        function removeBanner() {
            if (confirm('Are you sure you want to remove this banner image?')) {
                document.querySelector('.current-banner-preview').style.display = 'none';
                // Set a flag to remove banner on server
                document.getElementById('bannerUrlInput').value = 'REMOVE_BANNER';
            }
        }
    </script>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }

    <style>
        
        
        


        .right-nav {
            margin-left: auto;
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .right-nav a {
            color: #6c757d;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .right-nav a:hover {
            color: #007bff;
            background: rgba(0, 123, 255, 0.1);
        }

        /* Breadcrumb styles */
        .breadcrumb {
            margin-bottom: 2rem;
            font-size: 0.9rem;
            color: #6c757d;
            padding: 1rem 1.5rem;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            border-left: 4px solid #007bff;
        }

        .breadcrumb a {
            color: #007bff;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .breadcrumb a:hover {
            color: #0056b3;
            text-decoration: underline;
        }

        /* Page header styles */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
            padding: 2rem;
            background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 123, 255, 0.1);
        }

        .page-title-section {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .page-title {
            font-size: 2.25rem;
            font-weight: 800;
            background: linear-gradient(135deg, #2c3e50 0%, #007bff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
            position: relative;
        }

        .page-title::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 60px;
            height: 4px;
            background: linear-gradient(90deg, #007bff, #0056b3);
            border-radius: 2px;
        }

        .header-actions .btn-primary,
        .header-actions .btn-secondary {
            padding: 0.875rem 2rem;
            border: none;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
