@model List<PRN222_CloneEbay_Seller.Models.Store>
@{
    ViewData["Title"] = "Store Management";
    int currentSellerId = ViewBag.CurrentSellerId ?? 1;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Management | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs -->
            <div class="tabs-container">
                <a href="/Seller/Overview" class="tab">Overview</a>

                <!-- Tab Orders có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Orders" class="tab has-dropdown">Orders</a>
                    <div class="dropdown-menu">
                        <a href="/Orders?status=all" class="dropdown-item">All orders</a>
                        <a href="/Orders?status=awaiting-payment" class="dropdown-item">Awaiting payment</a>
                        <a href="/Orders?status=awaiting-shipment" class="dropdown-item">Awaiting shipment</a>
                        <a href="/Orders?status=shipped" class="dropdown-item">Paid and shipped</a>
                        <a href="/Orders?status=cancelled" class="dropdown-item">Cancellations</a>
                        <a href="/Orders/Returns" class="dropdown-item">Returns</a>
                        <a href="/Orders/Disputes" class="dropdown-item">Requests and disputes</a>
                        <a href="/Orders/ShippingLabels" class="dropdown-item">Shipping labels</a>
                    </div>
                </div>

                <!-- Tab Listings có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Listings</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Create listing</a>
                        <a href="#" class="dropdown-item">Active</a>
                        <a href="#" class="dropdown-item">Unsold</a>
                        <a href="#" class="dropdown-item">Drafts</a>
                        <a href="#" class="dropdown-item">Scheduled</a>
                        <a href="#" class="dropdown-item">Ended</a>
                    </div>
                </div>

                <!-- Tab Marketing có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                        <a href="#" class="dropdown-item">Email marketing</a>
                    </div>
                </div>

                <!-- Tab Store - Active -->
                <a href="/Stores" class="tab active">Store</a>

                <!-- Tab Performance có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Performance" class="tab has-dropdown">Performance</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Summary</a>
                        <a href="#" class="dropdown-item">Seller level</a>
                        <a href="#" class="dropdown-item">Sales</a>
                        <a href="#" class="dropdown-item">Traffic</a>
                    </div>
                </div>

                <!-- Tab Payments có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                        <a href="#" class="dropdown-item">Transaction history</a>
                    </div>
                </div>

                <!-- Tab thông thường khác -->
                <a href="#" class="tab">Research</a>

                <!-- Tab Reports có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                        <a href="#" class="dropdown-item">Performance reports</a>
                    </div>
                </div>

                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        <!-- Status Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="status-message status-success">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="status-message status-error">
                @TempData["Error"]
            </div>
        }

        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title-section">
                <h2 class="page-title">Store Management</h2>
                <p class="page-subtitle">Manage your eBay stores and customize your brand presence</p>
            </div>
            
            <div class="header-actions">
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <span class="btn-icon">➕</span>
                    Create New Store
                </a>
            </div>
        </div>

        <!-- Stores Grid -->
        @if (Model.Any())
        {
            <div class="stores-grid">
                @foreach (var store in Model)
                {
                    <div class="store-card">
                        <div class="store-banner">
                            @if (!string.IsNullOrEmpty(store.BannerImageUrl))
                            {
                                <img src="@store.BannerImageUrl" alt="@store.StoreName banner" class="store-banner-image" />
                            }
                            else
                            {
                                <div class="store-banner-placeholder">
                                    <span class="store-icon">🏪</span>
                                </div>
                            }
                            
                        </div>

                        <div class="store-content">
                            <div class="store-header">
                                <h3 class="store-name">@store.StoreName</h3>
                                <span class="store-status active">Active</span>
                            </div>

                            <div class="store-description">
                                @if (!string.IsNullOrEmpty(store.Description))
                                {
                                    <p>@(store.Description.Length > 120 ? store.Description.Substring(0, 120) + "..." : store.Description)</p>
                                }
                                else
                                {
                                    <p class="no-description">No description provided</p>
                                }
                            </div>

                            <div class="store-stats">
                                <div class="stat-item">
                                    <span class="stat-icon">📦</span>
                                    <span class="stat-label">Products</span>
                                    <span class="stat-value" id="products-@store.Id">-</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-icon">📊</span>
                                    <span class="stat-label">Orders</span>
                                    <span class="stat-value" id="orders-@store.Id">-</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-icon">⭐</span>
                                    <span class="stat-label">Rating</span>
                                    <span class="stat-value" id="rating-@store.Id">-</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-icon">💰</span>
                                    <span class="stat-label">Revenue</span>
                                    <span class="stat-value" id="revenue-@store.Id">-</span>
                                </div>
                            </div>

                            <div class="store-footer">
                                <div class="store-created">
                                    <span class="created-label">Store ID:</span>
                                    <span class="created-value">#@store.Id</span>
                                </div>
                                <div class="store-actions-buttons">
                                    <a href="@Url.Action("Details", new { id = store.Id })" class="btn btn-secondary btn-sm">
                                        View Store
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = store.Id })" class="btn btn-primary btn-sm">
                                        Manage
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">🏪</div>
                <div class="empty-title">No Stores Yet</div>
                <div class="empty-message">
                    You haven't created any stores yet. Create your first store to start showcasing your products with a professional brand presence.
                </div>
                <div class="empty-actions">
                    <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">
                        <span class="btn-icon">➕</span>
                        Create Your First Store
                    </a>
                </div>
                
                <div class="empty-features">
                    <h4>Why create a store?</h4>
                    <ul class="features-list">
                        <li>
                            <span class="feature-icon">🎨</span>
                            <span class="feature-text">Customize your brand with banners and descriptions</span>
                        </li>
                        <li>
                            <span class="feature-icon">📈</span>
                            <span class="feature-text">Track performance and analytics</span>
                        </li>
                        <li>
                            <span class="feature-icon">🛍️</span>
                            <span class="feature-text">Organize products by categories</span>
                        </li>
                        <li>
                            <span class="feature-icon">⭐</span>
                            <span class="feature-text">Build customer trust and loyalty</span>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Delete Store</h3>
                <span class="close" onclick="closeModal('deleteModal')">&times;</span>
            </div>
            <div class="modal-body">
                <div class="warning-icon">⚠️</div>
                <p>Are you sure you want to delete the store "<span id="storeNameToDelete"></span>"?</p>
                <p class="warning-text">This action cannot be undone. All store data will be permanently deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete Store</button>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 eBay Clone. All rights reserved.</p>
    </footer>

    <script>
        // Load store statistics
        document.addEventListener('DOMContentLoaded', function() {
            @foreach (var store in Model)
            {
                <text>loadStoreStats(@store.Id);</text>
            }
        });

        async function loadStoreStats(storeId) {
            try {
                const response = await fetch(`/Stores/GetStatistics/${storeId}`);
                if (response.ok) {
                    const stats = await response.json();
                    
                    document.getElementById(`products-${storeId}`).textContent = stats.totalProducts || 0;
                    document.getElementById(`orders-${storeId}`).textContent = stats.totalOrders || 0;
                    document.getElementById(`rating-${storeId}`).textContent = stats.averageRating ? `${stats.averageRating}/5` : 'N/A';
                    document.getElementById(`revenue-${storeId}`).textContent = stats.totalRevenue ? `$${stats.totalRevenue.toFixed(2)}` : '$0.00';
                }
            } catch (error) {
                console.error('Error loading store stats:', error);
            }
        }

        function toggleDropdown(storeId) {
            const dropdown = document.getElementById(`dropdown-${storeId}`);
            const isVisible = dropdown.style.display !== 'none';
            
            // Close all dropdowns
            document.querySelectorAll('.dropdown-menu').forEach(menu => {
                menu.style.display = 'none';
            });
            
            // Toggle current dropdown
            dropdown.style.display = isVisible ? 'none' : 'block';
        }

        function confirmDeleteStore(storeId, storeName) {
            document.getElementById('storeNameToDelete').textContent = storeName;
            document.getElementById('confirmDeleteBtn').onclick = function() {
                deleteStore(storeId);
            };
            document.getElementById('deleteModal').style.display = 'block';
        }

        async function deleteStore(storeId) {
            try {
                const response = await fetch(`/Stores/Delete/${storeId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const result = await response.json();
                
                if (result.success) {
                    location.reload(); // Refresh the page
                } else {
                    alert(result.message || 'Failed to delete store');
                }
            } catch (error) {
                console.error('Error deleting store:', error);
                alert('An error occurred while deleting the store');
            }
            
            closeModal('deleteModal');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
            if (!event.target.closest('.store-actions-dropdown')) {
                document.querySelectorAll('.dropdown-menu').forEach(menu => {
                    menu.style.display = 'none';
                });
            }
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        }
    </script>
</body>
</html>