@model List<PRN222_CloneEbay_Seller.Models.OrderTable>
@{
    ViewData["Title"] = "Performance Overview";
    var overview = ViewBag.Overview as Dictionary<string, object> ?? new Dictionary<string, object>();
    var revenueChartData = ViewBag.RevenueChartData as Dictionary<string, object> ?? new Dictionary<string, object>();
    var orderStats = ViewBag.OrderStats as Dictionary<string, int> ?? new Dictionary<string, int>();
    int selectedDays = ViewBag.SelectedDays ?? 30;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Performance | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs -->
            <div class="tabs-container">
                <a href="/Seller/Overview" class="tab">Overview</a>

                <div class="tab-wrapper">
                    <a href="/Orders" class="tab has-dropdown">Orders</a>
                    <div class="dropdown-menu">
                        <a href="/Orders?status=all" class="dropdown-item">All orders</a>
                        <a href="/Orders?status=awaiting-payment" class="dropdown-item">Awaiting payment</a>
                        <a href="/Orders?status=awaiting-shipment" class="dropdown-item">Awaiting shipment</a>
                        <a href="/Orders?status=shipped" class="dropdown-item">Paid and shipped</a>
                        <a href="/Orders?status=cancelled" class="dropdown-item">Cancellations</a>
                    </div>
                </div>

                <div class="tab-wrapper">
                    <a href="/Listing" class="tab has-dropdown">Listings</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Create listing</a>
                        <a href="#" class="dropdown-item">Active</a>
                        <a href="#" class="dropdown-item">Unsold</a>
                        <a href="#" class="dropdown-item">Drafts</a>
                    </div>
                </div>

                <div class="tab-wrapper">
                    <a href="/Coupon" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                    </div>
                </div>

                <a href="/Stores" class="tab">Store</a>

                <div class="tab-wrapper">
                    <a href="/Performance" class="tab has-dropdown active">Performance</a>
                    <div class="dropdown-menu">
                        <a href="/Performance" class="dropdown-item active">Overview</a>
                    </div>
                </div>

                <div class="tab-wrapper">
                    <a href="/Payment" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                    </div>
                </div>

                <a href="#" class="tab">Research</a>

                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                    </div>
                </div>

                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        <!-- Page Header with Time Filter -->
        <div class="page-header">
            <div class="page-title-section">
                <h2 class="page-title">Performance Overview</h2>
                <div class="filter-controls">
                    <div class="filter-group">
                        <label for="timeFilter" class="filter-label">Time period:</label>
                        <select id="timeFilter" class="filter-dropdown" onchange="filterByTime(this.value)">
                            @if (selectedDays == 7)
                            {
                                <option value="7" selected>Last 7 Days</option>
                            }
                            else
                            {
                                <option value="7">Last 7 Days</option>
                            }
                            
                            @if (selectedDays == 30)
                            {
                                <option value="30" selected>Last 30 Days</option>
                            }
                            else
                            {
                                <option value="30">Last 30 Days</option>
                            }
                            
                            @if (selectedDays == 90)
                            {
                                <option value="90" selected>Last 90 Days</option>
                            }
                            else
                            {
                                <option value="90">Last 90 Days</option>
                            }
                            
                            @if (selectedDays == 365)
                            {
                                <option value="365" selected>Last Year</option>
                            }
                            else
                            {
                                <option value="365">Last Year</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Overview Cards (đồng bộ với Order) -->
        <div class="cards-grid">
            <div class="overview-card">
                <div class="overview-card-title">Total Revenue (Delivered)</div>
                <div class="overview-card-value">$@(Convert.ToDecimal(overview.GetValueOrDefault("TotalRevenue", 0m)).ToString("N2"))</div>
                @{
                    var revenueGrowth = Convert.ToDecimal(overview.GetValueOrDefault("RevenueGrowth", 0));
                }
                <div class="overview-card-change @(revenueGrowth >= 0 ? "positive" : "negative")">
                    @(revenueGrowth >= 0 ? "+" : "")@revenueGrowth.ToString("N1")% vs previous period
                </div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Total Orders</div>
                <div class="overview-card-value">@overview.GetValueOrDefault("TotalOrders", 0)</div>
                <div class="overview-card-change">All orders in period</div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Successfully Delivered</div>
                <div class="overview-card-value">@orderStats.GetValueOrDefault("Delivered", 0)</div>
                <div class="overview-card-change">Completed orders</div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Average Order Value</div>
                <div class="overview-card-value">$@(Convert.ToDecimal(overview.GetValueOrDefault("AverageOrderValue", 0m)).ToString("N2"))</div>
                <div class="overview-card-change">Per order</div>
            </div>
        </div>

        

        <!-- Revenue Chart -->
        <div class="performance-charts">
            <div class="chart-container">
                <div class="chart-header">
                    <h3>Revenue Trends (Delivered Orders Only)</h3>
                    <div class="chart-stats">
                        <span class="chart-total">Total: $@(Convert.ToDecimal(revenueChartData.GetValueOrDefault("TotalRevenue", 0m)).ToString("N2"))</span>
                    </div>
                </div>
                <div class="chart-content">
                    <canvas id="revenueChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>

        <!-- Recent Sales Table -->
        <div class="panel">
            <div class="panel-header">
                <h3 class="panel-title">Recent Sales (Last @selectedDays days)</h3>
                <div class="panel-stats">
                    <span class="panel-stats-number">@Model.Count</span>
                    orders
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="orders-table">
                    <div class="orders-table-header">
                        <div class="order-col-id">Order ID</div>
                        <div class="order-col-buyer">Buyer</div>
                        <div class="order-col-items">Items</div>
                        <div class="order-col-total">Total</div>
                        <div class="order-col-status">Status</div>
                        <div class="order-col-date">Order Date</div>
                        <div class="order-col-actions">Actions</div>
                    </div>

                    @foreach (var order in Model)
                    {
                        <div class="order-row">
                            <div class="order-col-id">
                                <strong>#@order.Id</strong>
                            </div>
                            <div class="order-col-buyer">
                                <div class="buyer-info">
                                    <div class="buyer-name">@(order.Buyer?.Username ?? "Unknown")</div>
                                    <div class="buyer-email">@(order.Buyer?.Email ?? "")</div>
                                </div>
                            </div>
                            <div class="order-col-items">
                                @if (order.OrderItems.Any())
                                {
                                    <div class="order-items-list">
                                        @foreach (var item in order.OrderItems.Take(2))
                                        {
                                            <div class="order-item">
                                                <span class="item-name">@(item.Product?.Title ?? "Unknown Product")</span>
                                                <span class="item-qty">×@item.Quantity</span>
                                            </div>
                                        }
                                        @if (order.OrderItems.Count > 2)
                                        {
                                            <div class="more-items">+@(order.OrderItems.Count - 2) more</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="order-col-total">
                                <strong>$@(order.TotalPrice?.ToString("N2") ?? "0.00")</strong>
                            </div>
                            <div class="order-col-status">
                                <span class="status-badge status-@(order.Status?.ToLower() ?? "unknown")">
                                    @(order.Status ?? "Unknown")
                                </span>
                            </div>
                            <div class="order-col-date">
                                @order.OrderDate?.ToString("MMM dd, yyyy")
                            </div>
                            <div class="order-col-actions">
                                <div class="action-buttons">
                                    <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="action-btn">View</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">📊</div>
                    <div class="empty-title">No sales data found</div>
                    <div class="empty-message">
                        You don't have any sales in the last @selectedDays days. Start selling to see your performance data here!
                    </div>
                </div>
            }
        </div>
    </div>

    <script>
        function filterByTime(days) {
            const url = new URL(window.location);
            url.searchParams.set('days', days);
            window.location.href = url;
        }

        // Revenue Chart
        var revenueLabels = @Html.Raw(Json.Serialize(revenueChartData.GetValueOrDefault("Labels", new List<string>())));
        var revenueDataPoints = @Html.Raw(Json.Serialize(revenueChartData.GetValueOrDefault("Data", new List<decimal>())));

        var ctx = document.getElementById('revenueChart')?.getContext('2d');
        if (ctx) {
            var revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: revenueLabels,
                    datasets: [{
                        label: 'Daily Revenue',
                        data: revenueDataPoints,
                        borderColor: '#28a745',
                        backgroundColor: 'rgba(40, 167, 69, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: '#28a745',
                        pointBorderColor: '#28a745',
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0});
                                }
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>