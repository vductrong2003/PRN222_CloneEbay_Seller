@model List<PRN222_CloneEbay_Seller.Models.OrderTable>
@{
    ViewData["Title"] = "Performance Overview";
    var overview = ViewBag.Overview as Dictionary<string, object> ?? new Dictionary<string, object>();
    var revenueData = ViewBag.RevenueData as Dictionary<string, object> ?? new Dictionary<string, object>();
    int selectedDays = ViewBag.SelectedDays ?? 30;
    int selectedCount = ViewBag.SelectedCount ?? 15;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Performance | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs -->
            <div class="tabs-container">
                <a href="/Seller/Overview" class="tab">Overview</a>

                <!-- Tab Orders có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Orders" class="tab has-dropdown">Orders</a>
                    <div class="dropdown-menu">
                        <a href="/Orders?status=all" class="dropdown-item">All orders</a>
                        <a href="/Orders?status=awaiting-payment" class="dropdown-item">Awaiting payment</a>
                        <a href="/Orders?status=awaiting-shipment" class="dropdown-item">Awaiting shipment</a>
                        <a href="/Orders?status=shipped" class="dropdown-item">Paid and shipped</a>
                        <a href="/Orders?status=cancelled" class="dropdown-item">Cancellations</a>
                        <a href="/Orders/Returns" class="dropdown-item">Returns</a>
                        <a href="/Orders/Disputes" class="dropdown-item">Requests and disputes</a>
                        <a href="/Orders/ShippingLabels" class="dropdown-item">Shipping labels</a>
                    </div>
                </div>

                <!-- Other tabs -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Listings</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Create listing</a>
                        <a href="#" class="dropdown-item">Active</a>
                        <a href="#" class="dropdown-item">Unsold</a>
                        <a href="#" class="dropdown-item">Drafts</a>
                        <a href="#" class="dropdown-item">Scheduled</a>
                        <a href="#" class="dropdown-item">Ended</a>
                    </div>
                </div>

                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                        <a href="#" class="dropdown-item">Email marketing</a>
                    </div>
                </div>

                <!-- Tab thông thường -->
                <a href="/Stores" class="tab">Store</a>

                <!-- Tab Performance có dropdown - Active -->
                <div class="tab-wrapper">
                    <a href="/Performance" class="tab has-dropdown active">Performance</a>
                    <div class="dropdown-menu">
                        <a href="/Performance" class="dropdown-item active">Overview</a>
                        <a href="/Performance/Dashboard" class="dropdown-item">Dashboard</a>
                        <a href="/Performance/Sales" class="dropdown-item">Sales</a>
                        <a href="/Performance/Analytics" class="dropdown-item">Analytics</a>
                        <a href="/Performance/Products" class="dropdown-item">Products</a>
                    </div>
                </div>

                <!-- Tab Payments có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                        <a href="#" class="dropdown-item">Transaction history</a>
                    </div>
                </div>

                <!-- Tab thông thường khác -->
                <a href="#" class="tab">Research</a>

                <!-- Tab Reports có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                        <a href="#" class="dropdown-item">Performance reports</a>
                    </div>
                </div>

                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        <!-- Page Header với Time Filter và Count Filter -->
        <div class="page-header">
            <div class="page-title-section">
                <h2 class="page-title">Performance Overview</h2>
                <div class="filter-controls">
                    <!-- Quick Time Filter -->
                    <!-- Quick Time Filter -->
                    <div class="filter-group">
                        <label for="timeFilter" class="filter-label">Time period:</label>
                        <select id="timeFilter" class="filter-dropdown" onchange="filterByTime(this.value)">
                            <option value="7" selected="@(selectedDays == 7 ? "selected" : null)">Last 7 Days</option>
                            <option value="30" selected="@(selectedDays == 30 ? "selected" : null)">Last 30 Days</option>
                            <option value="90" selected="@(selectedDays == 90 ? "selected" : null)">Last 90 Days</option>
                            <option value="365" selected="@(selectedDays == 365 ? "selected" : null)">Last Year</option>
                            <option value="custom">Custom Range</option>
                        </select>
                    </div>

                    <!-- Show Count Filter -->
                    <div class="filter-group">
                        <label for="countFilter" class="filter-label">Show:</label>
                        <select id="countFilter" class="filter-dropdown" onchange="filterByCount(this.value)">
                            <option value="10" selected="@(selectedCount == 10 ? "selected" : null)">10 orders</option>
                            <option value="15" selected="@(selectedCount == 15 ? "selected" : null)">15 orders</option>
                            <option value="20" selected="@(selectedCount == 20 ? "selected" : null)">20 orders</option>
                            <option value="50" selected="@(selectedCount == 50 ? "selected" : null)">50 orders</option>
                        </select>
                    </div>

                </div>
            </div>
            
            <!-- Custom Date Range Filter (hidden by default) -->
            <div class="search-form" id="customDateRange" style="display: none;">
                <form action="/Performance/Search" method="get" class="search-controls">
                    <div class="date-range-inputs">
                        @{
                            string fromDateValue = ViewBag.FromDate?.ToString("yyyy-MM-dd") ?? "";
                            string toDateValue = ViewBag.ToDate?.ToString("yyyy-MM-dd") ?? "";
                        }
                        <input type="date" name="fromDate" id="fromDate" value="@fromDateValue" class="date-input" title="From Date">
                        <span class="date-separator">to</span>
                        <input type="date" name="toDate" id="toDate" value="@toDateValue" class="date-input" title="To Date">
                        <input type="hidden" name="count" value="@selectedCount">
                        <button type="submit" class="search-btn">Apply Date Range</button>
                        <button type="button" class="cancel-btn" onclick="cancelCustomRange()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Performance Overview Cards -->
        <div class="cards-grid">
            <div class="overview-card">
                <div class="overview-card-title">Total Revenue</div>
                <div class="overview-card-value">$@(Convert.ToDecimal(overview.GetValueOrDefault("TotalRevenue", 0m)).ToString("N2"))</div>
                @{
                    var revenueGrowth = Convert.ToDecimal(overview.GetValueOrDefault("RevenueGrowth", 0));
                    string growthIcon;
                    string growthClass;
                    
                    if (revenueGrowth >= 0)
                    {
                        growthIcon = "+";
                        growthClass = "positive";
                    }
                    else
                    {
                        growthIcon = "-";
                        growthClass = "negative";
                    }
                }
                <div class="overview-card-change @growthClass">
                    @growthIcon@Math.Abs(revenueGrowth).ToString("N1")% vs previous period
                </div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Total Orders</div>
                <div class="overview-card-value">@overview.GetValueOrDefault("TotalOrders", 0)</div>
                <div class="overview-card-change">Orders processed</div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Products Sold</div>
                <div class="overview-card-value">@overview.GetValueOrDefault("TotalProductsSold", 0)</div>
                <div class="overview-card-change">Units sold</div>
            </div>
            <div class="overview-card">
                <div class="overview-card-title">Average Order Value</div>
                <div class="overview-card-value">$@(Convert.ToDecimal(overview.GetValueOrDefault("AverageOrderValue", 0m)).ToString("N2"))</div>
                <div class="overview-card-change">Per order</div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="performance-charts">
            <div class="chart-container">
                <div class="chart-header">
                    <h3>Revenue Trends</h3>
                    <div class="chart-stats">
                        <span class="chart-total">Total: $@(Convert.ToDecimal(revenueData.GetValueOrDefault("TotalRevenue", 0m)).ToString("N2"))</span>
                        <span class="chart-average">Avg Daily: $@(Convert.ToDecimal(revenueData.GetValueOrDefault("AverageDaily", 0m)).ToString("N2"))</span>
                    </div>
                </div>
                <div class="chart-content">
                    <canvas id="revenueChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>

        <!-- Recent Sales Table với dynamic title -->
        <div class="panel">
            <div class="panel-header">
                <h3 class="panel-title">
                    Recent Sales 
                    @if (ViewBag.FromDate != null && ViewBag.ToDate != null)
                    {
                        <span class="date-range-info">
                            (@ViewBag.FromDate?.ToString("MMM dd") - @ViewBag.ToDate?.ToString("MMM dd, yyyy"))
                        </span>
                    }
                    else
                    {
                        <span class="date-range-info">(Last @selectedDays days)</span>
                    }
                </h3>
                <div class="panel-stats">
                    <span class="panel-stats-number">@Model.Count</span>
                    of @selectedCount orders
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="orders-table">
                    <div class="orders-table-header">
                        <div class="order-col-id">Order ID</div>
                        <div class="order-col-buyer">Buyer</div>
                        <div class="order-col-items">Items</div>
                        <div class="order-col-total">Total</div>
                        <div class="order-col-status">Status</div>
                        <div class="order-col-date">Order Date</div>
                        <div class="order-col-actions">Actions</div>
                    </div>

                    @foreach (var order in Model)
                    {
                        <div class="order-row">
                            <div class="order-col-id">
                                <strong>#@order.Id</strong>
                            </div>
                            <div class="order-col-buyer">
                                <div class="buyer-info">
                                    <div class="buyer-name">@(order.Buyer?.Username ?? "Unknown")</div>
                                    <div class="buyer-email">@(order.Buyer?.Email ?? "")</div>
                                </div>
                            </div>
                            <div class="order-col-items">
                                @if (order.OrderItems.Any())
                                {
                                    <div class="order-items-list">
                                        @foreach (var item in order.OrderItems.Take(2))
                                        {
                                            <div class="order-item">
                                                <span class="item-name">@(item.Product?.Title ?? "Unknown Product")</span>
                                                <span class="item-qty">@item.Quantity</span>
                                            </div>
                                        }
                                        @if (order.OrderItems.Count > 2)
                                        {
                                            <div class="more-items">+@(order.OrderItems.Count - 2) more items</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="order-col-total">
                                <strong>$@(order.TotalPrice?.ToString("N2") ?? "0.00")</strong>
                            </div>
                            <div class="order-col-status">
                                <span class="status-badge status-@(order.Status?.ToLower() ?? "unknown")">
                                    @(order.Status ?? "Unknown")
                                </span>
                            </div>
                            <div class="order-col-date">
                                @order.OrderDate?.ToString("MMM dd, yyyy")
                            </div>
                            <div class="order-col-actions">
                                <div class="action-buttons">
                                    <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="action-btn">View</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">📊</div>
                    <div class="empty-title">No sales data found</div>
                    <div class="empty-message">
                        @if (ViewBag.FromDate != null && ViewBag.ToDate != null)
                        {
                            <text>You don't have any sales between @ViewBag.FromDate?.ToString("MMM dd") and @ViewBag.ToDate?.ToString("MMM dd, yyyy"). Try selecting a different date range.</text>
                        }
                        else
                        {
                            <text>You don't have any sales in the last @selectedDays days. Start selling to see your performance data here!</text>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Performance Metrics Grid -->
        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-title">Active Products</div>
                <div class="metric-value">@overview.GetValueOrDefault("ActiveProducts", 0)</div>
                <div class="metric-description">Products available for sale</div>
            </div>
            <div class="metric-card">
                <div class="metric-title">Conversion Rate</div>
                <div class="metric-value">@((overview.GetValueOrDefault("ConversionRate", 0m)))%</div>
                <div class="metric-description">Visitors who made a purchase</div>
            </div>
            <div class="metric-card">
                <div class="metric-title">Time Period</div>
                <div class="metric-value">@selectedDays</div>
                <div class="metric-description">Days analyzed</div>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 eBay Clone. All rights reserved.</p>
    </footer>

    <script>
        // Filter by time period
        function filterByTime(days) {
            if (days === 'custom') {
                showCustomDateRange();
            } else {
                hideCustomDateRange();
                const url = new URL(window.location);
                url.searchParams.set('days', days);
                url.searchParams.set('count', @selectedCount);
                url.searchParams.delete('fromDate');
                url.searchParams.delete('toDate');
                window.location.href = url;
            }
        }

        // Filter by count
        function filterByCount(count) {
            const url = new URL(window.location);
            url.searchParams.set('count', count);
            url.searchParams.set('days', @selectedDays);
            window.location.href = url;
        }

        // Show custom date range
        function showCustomDateRange() {
            document.getElementById('customDateRange').style.display = 'block';
            // Set default dates (last 30 days to today)
            const today = new Date();
            const thirtyDaysAgo = new Date();
            thirtyDaysAgo.setDate(today.getDate() - 30);
            
            document.getElementById('toDate').value = today.toISOString().split('T')[0];
            document.getElementById('fromDate').value = thirtyDaysAgo.toISOString().split('T')[0];
        }

        // Hide custom date range
        function hideCustomDateRange() {
            document.getElementById('customDateRange').style.display = 'none';
        }

        // Cancel custom range
        function cancelCustomRange() {
            hideCustomDateRange();
            document.getElementById('timeFilter').value = '@selectedDays';
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Show custom date range if we have custom dates
            @if (ViewBag.FromDate != null && ViewBag.ToDate != null)
            {
                <text>
                document.getElementById('timeFilter').value = 'custom';
                showCustomDateRange();
                </text>
            }
        });

        // Revenue Chart với dynamic data
        var revenueLabels = @Html.Raw(Json.Serialize(revenueData.GetValueOrDefault("Labels", new List<string>())));
        var revenueDataPoints = @Html.Raw(Json.Serialize(revenueData.GetValueOrDefault("Data", new List<decimal>())));

        var ctx = document.getElementById('revenueChart')?.getContext('2d');
        if (ctx) {
            var revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: revenueLabels,
                    datasets: [{
                        label: 'Daily Revenue',
                        data: revenueDataPoints,
                        borderColor: '#4e73df',
                        backgroundColor: 'rgba(78, 115, 223, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: '#4e73df',
                        pointBorderColor: '#4e73df',
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0});
                                }
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        }
                    }
                }
            });
        }
    </script>

    <style>
        .filter-controls {
            display: flex;
            gap: 1rem;
            align-items: center;
        }
        
        .filter-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .filter-label {
            font-size: 0.9rem;
            color: #666;
            white-space: nowrap;
        }
        
        .filter-dropdown {
            padding: 0.4rem 0.8rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 0.9rem;
        }
        
        .date-range-inputs {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px;
            margin-top: 1rem;
        }
        
        .date-separator {
            color: #666;
            font-size: 0.9rem;
        }
        
        .cancel-btn {
            background: #6c757d;
            color: white;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            cursor: pointer;
        }
        
        .cancel-btn:hover {
            background: #5a6268;
        }
        
        .date-range-info {
            font-weight: normal;
            color: #666;
            font-size: 0.9rem;
        }
        
        .panel-stats {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #666;
        }
    </style>
</body>
</html>