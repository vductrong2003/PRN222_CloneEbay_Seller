@model PRN222_CloneEbay_Seller.Models.OrderTable
@{
    ViewData["Title"] = $"Order #{Model.Id} Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order #@Model.Id Details | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <div class="container">
        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a href="/Orders">Orders</a> > Order #@Model.Id Details
        </div>

        <!-- Status Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="status-message status-success">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="status-message status-error">
                @TempData["Error"]
            </div>
        }

        <!-- Order Header -->
        <div class="order-details-header">
            <div class="order-title">
                <h1>Order #@Model.Id</h1>
                <span class="status-badge status-@(Model.Status?.ToLower() ?? "unknown")">
                    @(Model.Status ?? "Unknown")
                </span>
            </div>
            <div class="order-date">
                Ordered on @Model.OrderDate?.ToString("MMMM dd, yyyy 'at' h:mm tt")
            </div>
        </div>

        <div class="order-details-grid">
            <!-- Left Column -->
            <div class="order-main-content">
                <!-- Order Items -->
                <div class="panel">
                    <div class="panel-header">
                        <h3 class="panel-title">Order Items</h3>
                        <div class="panel-stats">
                            @Model.OrderItems.Count item(s)
                        </div>
                    </div>
                    
                    <div class="order-items-details">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="order-item-detail">
                                <div class="item-image">
                                    @if (!string.IsNullOrEmpty(item.Product?.Images))
                                    {
                                        <img src="@item.Product.Images.Split(',').FirstOrDefault()" alt="@item.Product.Title" />
                                    }
                                    else
                                    {
                                        <div class="no-image">📦</div>
                                    }
                                </div>
                                <div class="item-info">
                                    <div class="item-title">@(item.Product?.Title ?? "Unknown Product")</div>
                                    <div class="item-details">
                                        <span class="item-sku">SKU: @(item.Product?.Id ?? 0)</span>
                                        <span class="item-category">@(item.Product?.Category?.Name ?? "No Category")</span>
                                    </div>
                                    <div class="item-pricing">
                                        <span class="item-price">$@(item.UnitPrice?.ToString("N2") ?? "0.00")</span>
                                        <span class="item-qty">Qty: @item.Quantity</span>
                                        <span class="item-total">Total: $@((item.UnitPrice * item.Quantity)?.ToString("N2") ?? "0.00")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="order-total-summary">
                        <div class="total-row">
                            <span class="total-label">Order Total:</span>
                            <span class="total-value">$@(Model.TotalPrice?.ToString("N2") ?? "0.00")</span>
                        </div>
                    </div>
                </div>

                <!-- Shipping Information -->
                @if (Model.ShippingInfos.Any())
                {
                    <div class="panel">
                        <div class="panel-header">
                            <h3 class="panel-title">Shipping Information</h3>
                        </div>
                        
                        @foreach (var shipping in Model.ShippingInfos)
                        {
                            <div class="shipping-details">
                                <div class="shipping-row">
                                    <span class="shipping-label">Carrier:</span>
                                    <span class="shipping-value">@(shipping.Carrier ?? "Not specified")</span>
                                </div>
                                <div class="shipping-row">
                                    <span class="shipping-label">Tracking Number:</span>
                                    <span class="shipping-value">@(shipping.TrackingNumber ?? "Not provided")</span>
                                </div>
                                <div class="shipping-row">
                                    <span class="shipping-label">Status:</span>
                                    <span class="shipping-status">@(shipping.Status ?? "Unknown")</span>
                                </div>
                                @if (shipping.EstimatedArrival.HasValue)
                                {
                                    <div class="shipping-row">
                                        <span class="shipping-label">Estimated Arrival:</span>
                                        <span class="shipping-value">@shipping.EstimatedArrival.Value.ToString("MMMM dd, yyyy")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Payment Information -->
                @if (Model.Payments.Any())
                {
                    <div class="panel">
                        <div class="panel-header">
                            <h3 class="panel-title">Payment Information</h3>
                        </div>
                        
                        @foreach (var payment in Model.Payments)
                        {
                            <div class="payment-details">
                                <div class="payment-row">
                                    <span class="payment-label">Amount:</span>
                                    <span class="payment-value">$@(payment.Amount?.ToString("N2") ?? "0.00")</span>
                                </div>
                                <div class="payment-row">
                                    <span class="payment-label">Method:</span>
                                    <span class="payment-value">@(payment.Method ?? "Not specified")</span>
                                </div>
                                <div class="payment-row">
                                    <span class="payment-label">Status:</span>
                                    <span class="payment-status status-@(payment.Status?.ToLower() ?? "unknown")">
                                        @(payment.Status ?? "Unknown")
                                    </span>
                                </div>
                                @if (payment.PaidAt.HasValue)
                                {
                                    <div class="payment-row">
                                        <span class="payment-label">Paid At:</span>
                                        <span class="payment-value">@payment.PaidAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Product Reviews (Only show when order is delivered) -->
                @if (Model.Status?.ToLower() == "delivered" && ViewBag.BuyerReviews != null)
                {
                    var reviews = ViewBag.BuyerReviews as List<PRN222_CloneEbay_Seller.Models.Review>;
                    if (reviews != null && reviews.Any())
                    {
                        <div class="panel">
                            <div class="panel-header">
                                <h3 class="panel-title">Product Reviews</h3>
                                <div class="panel-stats">
                                    @reviews.Count review(s) from buyer
                                </div>
                            </div>
                            
                            <div class="reviews-section">
                                @foreach (var review in reviews.Where(r => r.ReviewerId == Model.BuyerId))
                                {
                                    <div class="review-item">
                                        <div class="review-header">
                                            <div class="review-product">
                                                <div class="product-info">
                                                    @if (!string.IsNullOrEmpty(review.Product?.Images))
                                                    {
                                                        <img src="@review.Product.Images.Split(',').FirstOrDefault()" alt="@review.Product.Title" class="review-product-image" />
                                                    }
                                                    else
                                                    {
                                                        <div class="review-no-image">📦</div>
                                                    }
                                                    <div class="product-details">
                                                        <div class="product-title">@(review.Product?.Title ?? "Unknown Product")</div>
                                                        <div class="product-category">@(review.Product?.Category?.Name ?? "No Category")</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="review-meta">
                                                <div class="review-rating">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        @if (i <= (review.Rating ?? 0))
                                                        {
                                                            <span class="star filled">★</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="star empty">☆</span>
                                                        }
                                                    }
                                                    <span class="rating-number">(@(review.Rating ?? 0)/5)</span>
                                                </div>
                                                <div class="review-date">
                                                    @(review.CreatedAt?.ToString("MMMM dd, yyyy") ?? "Unknown date")
                                                </div>
                                            </div>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(review.Comment))
                                        {
                                            <div class="review-content">
                                                <div class="review-comment">
                                                    "@review.Comment"
                                                </div>
                                            </div>
                                        }
                                        
                                        <div class="review-footer">
                                            <div class="reviewer-info">
                                                <span class="reviewer-label">Review by:</span>
                                                <span class="reviewer-name">@(review.Reviewer?.Username ?? "Anonymous")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                
                                @if (!reviews.Any(r => r.ReviewerId == Model.BuyerId))
                                {
                                    <div class="no-reviews">
                                        <div class="no-reviews-icon">📝</div>
                                        <div class="no-reviews-title">No Reviews Yet</div>
                                        <div class="no-reviews-message">
                                            The buyer hasn't left any reviews for the products in this order yet.
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Right Column -->
            <div class="order-sidebar">
                <!-- Customer Information -->
                <div class="panel">
                    <div class="panel-header">
                        <h3 class="panel-title">Customer Information</h3>
                    </div>
                    
                    <div class="customer-details">
                        <div class="customer-row">
                            <span class="customer-label">Name:</span>
                            <span class="customer-value">@(Model.Buyer?.Username ?? "Unknown")</span>
                        </div>
                        <div class="customer-row">
                            <span class="customer-label">Email:</span>
                            <span class="customer-value">@(Model.Buyer?.Email ?? "Not provided")</span>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                @if (Model.Address != null)
                {
                    <div class="panel">
                        <div class="panel-header">
                            <h3 class="panel-title">Shipping Address</h3>
                        </div>
                        
                        <div class="address-details">
                            <div class="address-name">@(Model.Address.FullName ?? "N/A")</div>
                            <div class="address-street">@(Model.Address.Street ?? "")</div>
                            <div class="address-city">
                                @(Model.Address.City ?? ""), @(Model.Address.State ?? "") @(Model.Address.Country ?? "")
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Address.Phone))
                            {
                                <div class="address-phone">Phone: @Model.Address.Phone</div>
                            }
                        </div>
                    </div>
                }

                <!-- Order Actions -->
                <div class="panel">
                    <div class="panel-header">
                        <h3 class="panel-title">Order Actions</h3>
                    </div>
                    
                    <div class="order-actions">
                        <!-- Quick Action Buttons -->
                        <div id="quickActions" class="quick-actions">
                            <!-- Will be populated by JavaScript -->
                        </div>
                        
                        <!-- Current Status Info -->
                        <div class="current-status-info">
                            <div class="status-label">Current Status:</div>
                            <div class="status-value status-badge status-@(Model.Status?.ToLower() ?? "unknown")">
                                @(Model.Status ?? "Unknown")
                            </div>
                            <div class="allowed-transitions" id="allowedTransitions">
                                <div class="transitions-loading">Loading available actions...</div>
                            </div>
                        </div>

                        <!-- No Actions Available Message -->
                        <div id="noActionsMessage" class="no-actions-message" style="display: none;">
                            <div class="no-actions-icon">🔒</div>
                            <div class="no-actions-title">No Actions Available</div>
                            <div class="no-actions-description">
                                This order is at a final status and cannot be modified further.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ship Order Modal -->
    <div id="shipModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Ship Order #@Model.Id</h3>
                <span class="close" onclick="closeModal('shipModal')">&times;</span>
            </div>
            <form asp-action="Ship" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="form-group">
                    <label for="trackingNumber">Tracking Number:</label>
                    <input type="text" id="trackingNumber" name="trackingNumber" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="carrier">Carrier:</label>
                    <select id="carrier" name="carrier" class="form-control" required>
                        <option value="">Select Carrier</option>
                        <option value="UPS">UPS</option>
                        <option value="FedEx">FedEx</option>
                        <option value="USPS">USPS</option>
                        <option value="DHL">DHL</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="button-row">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('shipModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Ship Order</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cancel Order Modal -->
    <div id="cancelModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Cancel Order #@Model.Id</h3>
                <span class="close" onclick="closeModal('cancelModal')">&times;</span>
            </div>
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="form-group">
                    <label for="reason">Cancellation Reason:</label>
                    <textarea id="reason" name="reason" class="form-control" rows="3" placeholder="Enter reason for cancellation..."></textarea>
                </div>
                <div class="button-row">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('cancelModal')">Close</button>
                    <button type="submit" class="btn btn-cancel">Cancel Order</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Refund Modal -->
    <div id="refundModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Process Refund for Order #@Model.Id</h3>
                <span class="close" onclick="closeModal('refundModal')">&times;</span>
            </div>
            <form asp-action="ProcessRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="form-group">
                    <label for="amount">Refund Amount:</label>
                    <input type="number" id="amount" name="amount" class="form-control" 
                           step="0.01" min="0" max="@Model.TotalPrice" value="@Model.TotalPrice" required />
                    <div class="input-hint">Maximum refund: $@(Model.TotalPrice?.ToString("N2") ?? "0.00")</div>
                </div>
                <div class="form-group">
                    <label for="refundReason">Refund Reason:</label>
                    <textarea id="refundReason" name="reason" class="form-control" rows="3" 
                              placeholder="Enter reason for refund..."></textarea>
                </div>
                <div class="button-row">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('refundModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Process Refund</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function showShipModal(orderId) {
            document.getElementById('shipModal').style.display = 'block';
        }

        function showCancelModal(orderId) {
            document.getElementById('cancelModal').style.display = 'block';
        }

        function showRefundModal(orderId) {
            document.getElementById('refundModal').style.display = 'block';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const orderId = @Model.Id;
            const currentStatus = '@(Model.Status ?? "")';
            
            // Load buttons directly without API calls
            createQuickActionButtons(null, orderId);
            
            // Hide loading message and show status info
            const allowedTransitionsDiv = document.getElementById('allowedTransitions');
            allowedTransitionsDiv.innerHTML = `
                <div class="transitions-label">Current Status: <strong>${currentStatus}</strong></div>
                <div class="transitions-note">Use action buttons above to change status</div>
            `;
        });

        // Load available actions for the order
        async function loadAvailableActions(orderId, currentStatus) {
            try {
                // Get available actions
                const actionsResponse = await fetch(`/Orders/GetAvailableActions/${orderId}`);
                const actions = await actionsResponse.json();

                // Get allowed status transitions
                const validationResponse = await fetch(`/Orders/ValidateStatusChange?currentStatus=${encodeURIComponent(currentStatus)}&newStatus=`);
                const validation = await validationResponse.json();

                // Populate status select with allowed transitions
                populateStatusSelect(validation.allowedTransitions);
                
                // Update allowed transitions display
                updateAllowedTransitionsDisplay(validation.allowedTransitions);
                
                // Create quick action buttons
                createQuickActionButtons(actions, orderId);
                
                // Show/hide advance step button
                updateAdvanceStepButton(actions.canAdvanceToNext);

            } catch (error) {
                console.error('Error loading available actions:', error);
            }
        }

        // Populate status select dropdown with allowed transitions
        function populateStatusSelect(allowedTransitions) {
            const statusSelect = document.getElementById('statusSelect');
            
            // Clear existing options except the first one
            statusSelect.innerHTML = '<option value="">Select new status...</option>';
            
            // Add allowed transitions
            allowedTransitions.forEach(status => {
                const option = document.createElement('option');
                option.value = status;
                option.textContent = status;
                statusSelect.appendChild(option);
            });

            // If no transitions available, disable the select
            if (allowedTransitions.length === 0) {
                statusSelect.disabled = true;
                statusSelect.innerHTML = '<option value="">No status changes available</option>';
            }
        }

        // Update the allowed transitions display
        function updateAllowedTransitionsDisplay(allowedTransitions) {
            const allowedTransitionsDiv = document.getElementById('allowedTransitions');
            
            if (allowedTransitions.length > 0) {
                allowedTransitionsDiv.innerHTML = `
                    <div class="transitions-label">Allowed transitions:</div>
                    <div class="transitions-list">${allowedTransitions.join(', ')}</div>
                `;
            } else {
                allowedTransitionsDiv.innerHTML = `
                    <div class="transitions-label">No status changes available</div>
                    <div class="transitions-note">This order is at a final status</div>
                `;
            }
        }

        // Helper function to create action buttons
        function createActionButton(text, className, onClick) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `action-btn ${className} full-width`;
            button.textContent = text;
            button.onclick = onClick;
            return button;
        }

        // Create quick action buttons based on current status
        function createQuickActionButtons(actions, orderId) {
            const quickActionsDiv = document.getElementById('quickActions');
            quickActionsDiv.innerHTML = '<h4>Available Actions</h4>'; // Clear and add title

            const currentStatus = '@(Model.Status ?? "")';
            
            // ✅ LOGIC CẬP NHẬT THEO YÊU CẦU MỚI
            switch (currentStatus.toLowerCase()) {
                case 'pending':
                    // Pending có 3 nút: Mark as Paid, Ship, Cancel
                    quickActionsDiv.appendChild(createActionButton('💳 Mark as Paid', 'btn-paid', () => updateStatus(orderId, 'Paid')));
                    quickActionsDiv.appendChild(createActionButton('❌ Cancel Order', 'btn-cancel', () => showCancelModal(orderId)));
                    break;
                    
                case 'paid':
                    // Paid có 3 nút: Start Processing, Ship, Cancel
                    quickActionsDiv.appendChild(createActionButton('⚙️ Start Processing', 'btn-processing', () => updateStatus(orderId, 'Processing')));
                    break;
                    
                case 'processing':
                    // Processing có 2 nút: Ship, Cancel
                    quickActionsDiv.appendChild(createActionButton('📦 Ship Order', 'btn-ship', () => showShipModal(orderId)));
                    break;
                    
                case 'shipped':
                    // Shipped có thể chuyển thành Delivered hoặc Returned
                    quickActionsDiv.appendChild(createActionButton('✅ Mark as Delivered', 'btn-delivered', () => updateStatus(orderId, 'Delivered')));
                    quickActionsDiv.appendChild(createActionButton('↩️ Mark as Returned', 'btn-returned', () => updateStatus(orderId, 'Returned')));
                    break;
                    
                
                    
                case 'returned':
                    // Returned có thể chuyển thành Refunded
                    quickActionsDiv.appendChild(createActionButton('💰 Process Refund', 'btn-refund', () => showRefundModal(orderId)));
                    break;
                    
                case 'refunded':
                case 'cancelled':
                    // Status cuối - hiển thị thông báo
                    quickActionsDiv.innerHTML = `
                        <h4>Order Status</h4>
                        <div class="status-notice">
                            <div class="notice-icon">${currentStatus === 'refunded' ? '💰' : '❌'}</div>
                            <div class="notice-title">Order ${currentStatus.charAt(0).toUpperCase() + currentStatus.slice(1)}</div>
                            <div class="notice-message">
                                ${currentStatus === 'refunded' ? 'This order has been refunded.' :
                                  'This order has been cancelled.'}
                            </div>
                        </div>
                    `;
                    break;
                    
                default:
                    // Status không xác định
                    quickActionsDiv.innerHTML = `
                        <h4>Order Status</h4>
                        <div class="status-notice">
                            <div class="notice-icon">❓</div>
                            <div class="notice-title">Unknown Status</div>
                            <div class="notice-message">Status: ${currentStatus || 'Unknown'}</div>
                        </div>
                    `;
                    break;
            }
        }

        // Update advance step button visibility
        function updateAdvanceStepButton(canAdvanceToNext) {
            const advanceStepBtn = document.getElementById('advanceStepBtn');
            if (canAdvanceToNext) {
                advanceStepBtn.style.display = 'block';
            } else {
                advanceStepBtn.style.display = 'none';
            }
        }

        // Quick function to update status with confirmation
        async function updateStatus(orderId, newStatus) {
            if (confirm(`Are you sure you want to change the order status to "${newStatus}"?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Orders/UpdateStatus';
                
                // Add CSRF token
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;
                
                const orderIdInput = document.createElement('input');
                orderIdInput.type = 'hidden';
                orderIdInput.name = 'orderId';
                orderIdInput.value = orderId;
                
                const statusInput = document.createElement('input');
                statusInput.type = 'hidden';
                statusInput.name = 'status';
                statusInput.value = newStatus;
                
                form.appendChild(tokenInput);
                form.appendChild(orderIdInput);
                form.appendChild(statusInput);
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Validate status change before submission
        async function validateStatusChange(currentStatus, newStatus) {
            try {
                const response = await fetch(`/Orders/ValidateStatusChange?currentStatus=${encodeURIComponent(currentStatus)}&newStatus=${encodeURIComponent(newStatus)}`);
                const validation = await response.json();
                
                if (!validation.isValid) {
                    alert(`Cannot change status: ${validation.errorMessage}`);
                    document.getElementById('statusSelect').value = '';
                    document.getElementById('updateStatusBtn').disabled = true;
                }
            } catch (error) {
                console.error('Error validating status change:', error);
            }
        }
    </script>
</body>
</html>