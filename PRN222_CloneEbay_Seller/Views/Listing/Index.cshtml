@model List<PRN222_CloneEbay_Seller.Models.Product>
@{
    ViewData["Title"] = "Listings Management";
    string currentStatus = ViewBag.CurrentStatus ?? "all";
    var statistics = ViewBag.Statistics as Dictionary<string, int> ?? new Dictionary<string, int>();
    var categories = ViewBag.Categories as List<PRN222_CloneEbay_Seller.Models.Category> ?? new List<PRN222_CloneEbay_Seller.Models.Category>();
    string currentSearch = ViewBag.CurrentSearch ?? "";
    int? currentCategoryId = ViewBag.CurrentCategoryId;
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listings | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs -->
            <div class="tabs-container">
                <a href="/Seller/Overview" class="tab">Overview</a>

                <!-- Tab Orders có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Orders" class="tab has-dropdown">Orders</a>
                    <div class="dropdown-menu">
                        <a href="/Orders?status=all" class="dropdown-item">All orders</a>
                        <a href="/Orders?status=awaiting-payment" class="dropdown-item">Awaiting payment</a>
                        <a href="/Orders?status=awaiting-shipment" class="dropdown-item">Awaiting shipment</a>
                        <a href="/Orders?status=shipped" class="dropdown-item">Paid and shipped</a>
                        <a href="/Orders?status=cancelled" class="dropdown-item">Cancellations</a>
                        <a href="/Orders/Returns" class="dropdown-item">Returns</a>
                        <a href="/Orders/Disputes" class="dropdown-item">Requests and disputes</a>
                        <a href="/Orders/ShippingLabels" class="dropdown-item">Shipping labels</a>
                    </div>
                </div>

                <!-- Tab Listings có dropdown - Active -->
                <div class="tab-wrapper">
                    <a href="/Listing" class="tab has-dropdown active">Listings</a>
                    <div class="dropdown-menu">
                        <a href="/Listing/Create" class="dropdown-item">Create listing</a>
                        <a href="/Listing/Active" class="dropdown-item @(currentStatus == "active" ? "active" : "")">Active</a>
                        <a href="/Listing/Inactive" class="dropdown-item @(currentStatus == "inactive" ? "active" : "")">Inactive</a>
                        <a href="/Listing/Drafts" class="dropdown-item @(currentStatus == "drafts" ? "active" : "")">Drafts</a>
                        <a href="/Listing/Scheduled" class="dropdown-item @(currentStatus == "scheduled" ? "active" : "")">Scheduled</a>
                        <a href="/Listing/TopPerforming" class="dropdown-item @(currentStatus == "top-performing" ? "active" : "")">Top Performing</a>
                    </div>
                </div>

                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                        <a href="#" class="dropdown-item">Email marketing</a>
                    </div>
                </div>

                <!-- Tab thông thường -->
                <a href="/Stores" class="tab">Store</a>

                <!-- Tab Performance có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Performance" class="tab has-dropdown">Performance</a>
                    <div class="dropdown-menu">
                        <a href="/Performance" class="dropdown-item">Overview</a>
                        <a href="/Performance/Dashboard" class="dropdown-item">Dashboard</a>
                        <a href="/Performance/Sales" class="dropdown-item">Sales</a>
                        <a href="/Performance/Analytics" class="dropdown-item">Analytics</a>
                        <a href="/Performance/Products" class="dropdown-item">Products</a>
                    </div>
                </div>

                <!-- Tab Payments có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                        <a href="#" class="dropdown-item">Transaction history</a>
                    </div>
                </div>

                <!-- Tab thông thường khác -->
                <a href="#" class="tab">Research</a>

                <!-- Tab Reports có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                        <a href="#" class="dropdown-item">Performance reports</a>
                    </div>
                </div>

                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        <!-- Status Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="status-message status-success">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="status-message status-error">
                @TempData["Error"]
            </div>
        }

        <!-- Page Header with Filters -->
        <div class="page-header">
            <div class="page-title-section">
                <h2 class="page-title">My Listings</h2>
                <div class="header-actions">
                    <a href="@Url.Action("Create")" class="btn-primary">
                        <span class="icon">+</span>
                        Create New Listing
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter and Search Section -->
        <div class="filters-section">
            <div class="status-filters">
                <a href="/Listing?status=all" class="filter-tab @(currentStatus == "all" ? "active" : "")">
                    All (@(statistics.GetValueOrDefault("Total", 0)))
                </a>
                <a href="/Listing?status=active" class="filter-tab @(currentStatus == "active" ? "active" : "")">
                    Active (@(statistics.GetValueOrDefault("Active", 0)))
                </a>
                <a href="/Listing?status=inactive" class="filter-tab @(currentStatus == "inactive" ? "active" : "")">
                    Inactive (@(statistics.GetValueOrDefault("Inactive", 0)))
                </a>
                <a href="/Listing?status=draft" class="filter-tab @(currentStatus == "draft" ? "active" : "")">
                    Drafts (@(statistics.GetValueOrDefault("Draft", 0)))
                </a>
                <a href="/Listing?status=scheduled" class="filter-tab @(currentStatus == "scheduled" ? "active" : "")">
                    Scheduled (@(statistics.GetValueOrDefault("Scheduled", 0)))
                </a>
            </div>

            <div class="search-filter-row">
                <form asp-action="Index" method="get" class="search-form">
                    <div class="search-group">
                        <input type="text" name="search" placeholder="Search products..." 
                               value="@currentSearch" class="search-input">
                        <button type="submit" class="search-btn">Search</button>
                    </div>
                    
                    <div class="category-filter">
                        <label for="categoryFilter">Category:</label>
                        <select name="categoryId" id="categoryFilter" onchange="this.form.submit()">
                            <option value="">All Categories</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id" selected="@(currentCategoryId == category.Id ? "selected" : null)">
                                    @category.Name
                                </option>
                            }

                        </select>
                    </div>
                    
                    <input type="hidden" name="status" value="@currentStatus">
                </form>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="cards-grid">
            <div class="stats-card">
                <div class="stats-icon">📦</div>
                <div class="stats-content">
                    <div class="stats-number">@(statistics.GetValueOrDefault("Total", 0))</div>
                    <div class="stats-label">Total Products</div>
                </div>
            </div>
            <div class="stats-card">
                <div class="stats-icon">✅</div>
                <div class="stats-content">
                    <div class="stats-number">@(statistics.GetValueOrDefault("Active", 0))</div>
                    <div class="stats-label">Active Listings</div>
                </div>
            </div>
            <div class="stats-card">
                <div class="stats-icon">⚠️</div>
                <div class="stats-content">
                    <div class="stats-number">@(statistics.GetValueOrDefault("LowStock", 0))</div>
                    <div class="stats-label">Low Stock</div>
                </div>
            </div>
            <div class="stats-card">
                <div class="stats-icon">🔨</div>
                <div class="stats-content">
                    <div class="stats-number">@(statistics.GetValueOrDefault("Auction", 0))</div>
                    <div class="stats-label">Auction Items</div>
                </div>
            </div>
        </div>

        <!-- Products List -->
        <div class="products-container">
            @if (Model.Any())
            {
                <div class="products-list">
                    <!-- List Header -->
                    <div class="list-header">
                        <div class="header-cell image-col">Image</div>
                        <div class="header-cell product-col">Product</div>
                        <div class="header-cell price-col">Price</div>
                        <div class="header-cell stock-col">Stock</div>
                        <div class="header-cell status-col">Status</div>
                        <div class="header-cell actions-col">Actions</div>
                    </div>

                    <!-- List Items -->
                    @foreach (var product in Model)
                    {
                        <div class="list-item">
                            <!-- Product Image -->
                            <div class="list-cell image-col">
                                @{
                                    var imageUrls = !string.IsNullOrEmpty(product.Images) ? product.Images.Split(',').Select(img => img.Trim()).ToList() : new List<string>();
                                    var mainImageUrl = imageUrls.FirstOrDefault();
                                }
                                @if (!string.IsNullOrEmpty(mainImageUrl))
                                {
                                    <img src="@mainImageUrl" alt="@product.Title" class="list-product-image">
                                }
                                else
                                {
                                    <div class="list-no-image">
                                        <span class="no-image-icon">📷</span>
                                    </div>
                                }
                            </div>

                            <!-- Product Info -->
                            <div class="list-cell product-col">
                                <div class="product-info-content">
                                    <h3 class="list-product-title">
                                        <a href="@Url.Action("Details", new { id = product.Id })">@product.Title</a>
                                    </h3>
                                    <div class="list-product-meta">
                                        <span class="product-id">ID: @product.Id</span>
                                        <span class="product-category">@(product.Category?.Name ?? "Uncategorized")</span>
                                        @if (product.IsAuction == true)
                                        {
                                            <span class="listing-type auction">Auction</span>
                                        }
                                        else
                                        {
                                            <span class="listing-type buy-now">Buy It Now</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Price -->
                            <div class="list-cell price-col">
                                <div class="price-content">
                                    <span class="price-amount">$@(product.Price?.ToString("N2") ?? "0.00")</span>
                                    @if (product.IsAuction == true)
                                    {
                                        <span class="price-label">Starting bid</span>
                                    }
                                    else
                                    {
                                        <span class="price-label">Buy It Now</span>
                                    }
                                </div>
                            </div>

                            <!-- Stock -->
                            <div class="list-cell stock-col">
                                @{
                                    var totalStock = product.Inventories?.Sum(i => i.Quantity) ?? 0;
                                    var totalSold = product.OrderItems?.Sum(oi => oi.Quantity) ?? 0;
                                    var stockClass = totalStock <= 5 ? "low" : totalStock > 0 ? "normal" : "out";
                                }
                                <div class="stock-content">
                                    <div class="stock-info stock-@stockClass">
                                        <span class="stock-number">@totalStock</span>
                                        <span class="stock-label">available</span>
                                    </div>
                                    <div class="sold-info">
                                        <span class="sold-number">@totalSold</span>
                                        <span class="sold-label">sold</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="list-cell status-col">
                                @{
                                    var statusText = product.Status ?? "Active";
                                    var statusClass = product.Status?.ToLower() switch
                                    {
                                        "active" => "status-active",
                                        "inactive" => "status-inactive", 
                                        "draft" => "status-draft",
                                        "scheduled" => "status-scheduled",
                                        "ended" => "status-ended",
                                        _ => "status-active"
                                    };
                                }
                                <span class="status-badge @statusClass">@statusText</span>
                            </div>

                            <!-- Actions -->
                            <div class="list-cell actions-col">
                                <div class="list-actions">
                                    <a href="@Url.Action("Details", new { id = product.Id })" class="action-btn btn-view" title="View Details">
                                        <span class="btn-icon">👁️</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">📦</div>
                    <h3 class="empty-title">No products found</h3>
                    <div class="empty-message">
                        @{
                            string emptyMessage = currentStatus switch
                            {
                                "active" => "You don't have any active products. Create your first listing to start selling!",
                                "inactive" => "You don't have any inactive products.",
                                "auction" => "You don't have any auction items.",
                                "buy-now" => "You don't have any Buy It Now items.",
                                "draft" => "You don't have any draft products.",
                                "scheduled" => "You don't have any scheduled products.",
                                "top-performing" => "No performance data available yet.",
                                _ => !string.IsNullOrEmpty(currentSearch) 
                                    ? $"No products found matching '{currentSearch}'. Try a different search term."
                                    : "You don't have any products yet. Create your first listing to start selling!"
                            };
                        }
                        @emptyMessage
                    </div>
                    @if (currentStatus == "all" && string.IsNullOrEmpty(currentSearch))
                    {
                        <div class="empty-action">
                            <a href="@Url.Action("Create")" class="btn-primary">
                                <span class="icon">+</span>
                                Create Your First Listing
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Edit Stock Modal -->
    <div id="editStockModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Update Stock Quantity</h3>
                <span class="close" onclick="closeModal('editStockModal')">&times;</span>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="newStock">New Stock Quantity:</label>
                    <input type="number" id="newStock" class="form-control" min="0" />
                    <small class="form-help">Enter the new quantity for this product</small>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('editStockModal')">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="updateStock()">Update Stock</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Delete Product</h3>
                <span class="close" onclick="closeModal('deleteModal')">&times;</span>
            </div>
            <div class="modal-body">
                <p class="delete-warning">Are you sure you want to delete this product? This action cannot be undone.</p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
                    <form id="deleteForm" asp-action="Delete" method="post" style="display: inline;">
                        <input type="hidden" id="deleteProductId" name="id" />
                        <button type="submit" class="btn btn-danger">Delete Product</button>
                    </form>
                </div>
            </div>
        </div>
    </div>



    <script>
        let currentProductId = null;

        function editStock(productId, currentStock) {
            currentProductId = productId;
            document.getElementById('newStock').value = currentStock;
            document.getElementById('editStockModal').style.display = 'block';
        }

        function updateStock() {
            const newStock = document.getElementById('newStock').value;
            if (newStock === '' || newStock < 0) {
                alert('Please enter a valid stock quantity');
                return;
            }

            fetch('/Listing/UpdateInventory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    productId: currentProductId,
                    quantity: parseInt(newStock)
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Failed to update stock');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating stock');
            });

            closeModal('editStockModal');
        }

        function deleteProduct(productId) {
            document.getElementById('deleteProductId').value = productId;
            document.getElementById('deleteModal').style.display = 'block';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        }
    </script>

    <style>
        /* Modern Card-based Layout */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e9ecef;
        }

        .page-title-section {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 600;
            color: #2c3e50;
            margin: 0;
        }

        .header-actions .btn-primary {
            background: #007bff;
            color: white;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .header-actions .btn-primary:hover {
            background: #0056b3;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
        }

        /* Filter Section */
        .filters-section {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .status-filters {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 1rem;
        }

        .filter-tab {
            padding: 0.75rem 1.5rem;
            border-radius: 25px;
            text-decoration: none;
            color: #6c757d;
            background: #f8f9fa;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .filter-tab:hover {
            color: #007bff;
            background: #e3f2fd;
        }

        .filter-tab.active {
            background: #007bff;
            color: white;
        }

        .search-filter-row {
            display: flex;
            gap: 1rem;
            align-items: end;
        }

        .search-form {
            display: flex;
            gap: 1rem;
            align-items: end;
            flex: 1;
        }

        .search-group {
            display: flex;
            gap: 0.5rem;
            flex: 1;
        }

        .search-input {
            flex: 1;
            padding: 0.75rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: #007bff;
        }

        .search-btn {
            padding: 0.75rem 1.5rem;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.3s ease;
        }

        .search-btn:hover {
            background: #218838;
        }

        .category-filter {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .category-filter label {
            font-weight: 600;
            color: #495057;
            font-size: 0.9rem;
        }

        .category-filter select {
            padding: 0.75rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            min-width: 200px;
        }

        /* Stats Cards */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stats-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        .stats-card:hover {
            transform: translateY(-2px);
        }

        .stats-icon {
            font-size: 2.5rem;
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #f8f9fa;
        }

        .stats-content {
            flex: 1;
        }

        .stats-number {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
            line-height: 1;
        }

        .stats-label {
            color: #6c757d;
            font-size: 0.9rem;
            margin-top: 0.25rem;
        }

        /* Products Grid */
        .products-container {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .products-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .list-header {
            display: grid;
            grid-template-columns: 80px 1fr 140px 120px 120px 150px;
            align-items: center;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px 8px 0 0;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid #e9ecef;
        }

        .header-cell {
            padding: 0.5rem;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .list-item {
            display: grid;
            grid-template-columns: 80px 1fr 140px 120px 120px 150px;
            align-items: center;
            padding: 1rem;
            border: 1px solid #e9ecef;
            border-top: none;
            background: white;
            transition: all 0.3s ease;
        }

        .list-item:hover {
            background: #f8f9fa;
            transform: translateX(4px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .list-item:last-child {
            border-radius: 0 0 8px 8px;
        }

        .list-cell {
            padding: 0.5rem;
        }

        /* Image Column */
        .image-col {
            text-align: center;
        }

        .list-product-image {
            width: 60px;
            height: 60px;
            border-radius: 8px;
            object-fit: cover;
            border: 2px solid #e9ecef;
        }

        .list-no-image {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            border: 2px solid #e9ecef;
        }

        .list-no-image .no-image-icon {
            font-size: 1.5rem;
            opacity: 0.5;
        }

        /* Product Column */
        .product-col {
            flex: 1;
        }

        .product-info-content {
            padding: 0;
        }

        .list-product-title {
            margin: 0 0 0.5rem 0;
            font-size: 1rem;
            font-weight: 600;
            line-height: 1.3;
        }

        .list-product-title a {
            color: #2c3e50;
