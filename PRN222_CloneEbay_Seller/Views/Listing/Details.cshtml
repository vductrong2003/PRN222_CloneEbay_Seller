@model PRN222_CloneEbay_Seller.Models.Product
@{
    ViewData["Title"] = "Product Details - " + Model.Title;
    var reviews = ViewBag.Reviews as List<PRN222_CloneEbay_Seller.Models.Review> ?? new List<PRN222_CloneEbay_Seller.Models.Review>();
    var relatedProducts = ViewBag.RelatedProducts as List<PRN222_CloneEbay_Seller.Models.Product> ?? new List<PRN222_CloneEbay_Seller.Models.Product>();
    var averageRating = reviews.Any() ? reviews.Average(r => r.Rating ?? 0) : 0;
    var totalReviews = reviews.Count;
    var totalStock = Model.Inventories?.Sum(i => i.Quantity) ?? 0;
    var totalSold = Model.OrderItems?.Sum(oi => oi.Quantity) ?? 0;
    
    // Handle Images property - split by comma if multiple images
    var imageUrls = !string.IsNullOrEmpty(Model.Images) ? Model.Images.Split(',').Select(img => img.Trim()).ToList() : new List<string>();
    var mainImageUrl = imageUrls.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        .product-details-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .breadcrumb {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
        }

        .breadcrumb a {
            color: #007bff;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .product-header {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
        }

        .product-main-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .product-images {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .main-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 12px;
            border: 2px solid #e9ecef;
        }

        .thumbnail-gallery {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid #e9ecef;
            cursor: pointer;
            transition: border-color 0.3s ease;
        }

        .thumbnail:hover,
        .thumbnail.active {
            border-color: #007bff;
        }

        .product-info {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .product-title {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
            line-height: 1.3;
        }

        .product-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        .rating-section {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .stars {
            display: flex;
            gap: 0.2rem;
        }

        .star {
            color: #ffc107;
            font-size: 1.2rem;
        }

        .star.empty {
            color: #e9ecef;
        }

        .rating-text {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .product-badges {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .badge {
            padding: 0.25rem 0.75rem;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .badge-category {
            background: #e9ecef;
            color: #495057;
        }

        .badge-status {
            background: #d4edda;
            color: #155724;
        }

        .badge-type {
            background: #d1ecf1;
            color: #0c5460;
        }

        .price-section {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 12px;
            border: 2px solid #e9ecef;
        }

        .price-main {
            font-size: 2.5rem;
            font-weight: 700;
            color: #28a745;
            margin-bottom: 0.5rem;
        }

        .price-label {
            color: #6c757d;
            font-size: 1rem;
        }

        .stock-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .stock-item {
            text-align: center;
        }

        .stock-number {
            font-size: 1.5rem;
            font-weight: 700;
            display: block;
        }

        .stock-available {
            color: #28a745;
        }

        .stock-sold {
            color: #6c757d;
        }

        .stock-label {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: #007bff;
            color: white;
        }

        .btn-primary:hover {
            background: #0056b3;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #545b62;
        }

        .btn-warning {
            background: #ffc107;
            color: #212529;
        }

        .btn-warning:hover {
            background: #e0a800;
        }

        .btn-info {
            background: #17a2b8;
            color: white;
        }

        .btn-info:hover {
            background: #138496;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-danger:hover {
            background: #c82333;
        }

        .details-sections {
            display: grid;
            gap: 2rem;
        }

        .details-section {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #e9ecef;
        }

        .description-content {
            line-height: 1.6;
            color: #495057;
        }

        .specifications-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        .spec-item {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .spec-label {
            font-weight: 600;
            color: #495057;
        }

        .spec-value {
            color: #6c757d;
        }

        .reviews-section {
            margin-top: 2rem;
        }

        .reviews-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .reviews-stats {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .average-rating {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .average-number {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
        }

        .reviews-list {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .review-item {
            padding: 1.5rem;
            background: #f8f9fa;
            border-radius: 12px;
            border-left: 4px solid #007bff;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .reviewer-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .reviewer-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #007bff;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .reviewer-name {
            font-weight: 600;
            color: #2c3e50;
        }

        .review-date {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .review-rating {
            display: flex;
            gap: 0.2rem;
        }

        .review-content {
            color: #495057;
            line-height: 1.6;
        }

        .related-products {
            margin-top: 3rem;
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .related-item {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        .related-item:hover {
            transform: translateY(-4px);
        }

        .related-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .related-info {
            padding: 1rem;
        }

        .related-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .related-price {
            color: #28a745;
            font-weight: 700;
            font-size: 1.1rem;
        }

        .back-button {
            margin-bottom: 2rem;
        }

        .no-reviews {
            text-align: center;
            padding: 2rem;
            color: #6c757d;
        }

        .no-image {
            width: 100%;
            height: 400px;
            background: #f8f9fa;
            border: 2px dashed #e9ecef;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            font-size: 1.2rem;
        }

        /* Modal Styles */
        .modal {
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            border-radius: 12px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h3 {
            margin: 0;
            color: #2c3e50;
        }

        .close {
            font-size: 1.5rem;
            cursor: pointer;
            color: #6c757d;
            transition: color 0.3s ease;
        }

        .close:hover {
            color: #dc3545;
        }

        .modal-body {
            padding: 1.5rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #495057;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
        }

        .form-help {
            color: #6c757d;
            font-size: 0.8rem;
            margin-top: 0.25rem;
        }

        .modal-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            margin-top: 1.5rem;
        }

        .delete-warning {
            color: #721c24;
            background: #f8d7da;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

    </style>
</head>
<body>
    <div class="product-details-container">
        <!-- Back Button -->
        <div class="back-button">
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <span>←</span>
                Back to Listings
            </a>
        </div>

        <!-- Breadcrumb -->
        <nav class="breadcrumb">
            <a href="@Url.Action("Index", "Home")">Home</a> &gt;
            <a href="@Url.Action("Index")">Listings</a> &gt;
            <span>@Model.Title</span>
        </nav>

        <!-- Product Header -->
        <div class="product-header">
            <div class="product-main-section">
                <!-- Product Images -->
                <div class="product-images">
                    @if (!string.IsNullOrEmpty(mainImageUrl))
                    {
                        <img src="@mainImageUrl" alt="@Model.Title" class="main-image" id="mainImage">
                        @if (imageUrls.Count > 1)
                        {
                            <div class="thumbnail-gallery">
                                @foreach (var imageUrl in imageUrls)
                                {
                                    <img src="@imageUrl" alt="@Model.Title" class="thumbnail @(imageUrl == mainImageUrl ? "active" : "")" onclick="changeMainImage('@imageUrl')">
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-image">
                            📷 No Image Available
                        </div>
                    }
                </div>

                <!-- Product Info -->
                <div class="product-info">
                    <h1 class="product-title">@Model.Title</h1>

                    <div class="product-meta">
                        <div class="rating-section">
                            <div class="stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star @(i <= averageRating ? "" : "empty")">★</span>
                                }
                            </div>
                            <span class="rating-text">
                                (@totalReviews @(totalReviews == 1 ? "review" : "reviews"))
                            </span>
                        </div>

                        <div class="product-badges">
                            <span class="badge badge-category">@(Model.Category?.Name ?? "Uncategorized")</span>
                            <span class="badge badge-status">@(Model.Status ?? "Active")</span>
                            @if (Model.IsAuction == true)
                            {
                                <span class="badge badge-type">Auction</span>
                            }
                            else
                            {
                                <span class="badge badge-type">Buy It Now</span>
                            }
                        </div>
                    </div>

                    <div class="price-section">
                        <div class="price-main">$@(Model.Price?.ToString("N2") ?? "0.00")</div>
                        <div class="price-label">
                            @if (Model.IsAuction == true)
                            {
                                <span>Starting bid</span>
                                @if (Model.AuctionEndTime.HasValue)
                                {
                                    <div style="margin-top: 0.5rem; color: #dc3545; font-weight: 600;">
                                        Ends: @Model.AuctionEndTime.Value.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                }
                            }
                            else
                            {
                                <span>Buy It Now price</span>
                            }
                        </div>
                    </div>

                    <div class="stock-info">
                        <div class="stock-item">
                            <span class="stock-number stock-available">@totalStock</span>
                            <span class="stock-label">Available</span>
                        </div>
                        <div class="stock-item">
                            <span class="stock-number stock-sold">@totalSold</span>
                            <span class="stock-label">Sold</span>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
                            <span>✏️</span>
                            Edit Product
                        </a>
                        <a href="@Url.Action("Performance", new { id = Model.Id })" class="btn btn-secondary">
                            <span>📊</span>
                            View Performance
                        </a>
                        @if (Model.Status == "Active" || Model.Status == "Inactive")
                        {
                            <button type="button" class="btn btn-info" onclick="editStock(@Model.Id, @totalStock)" title="Update Stock">
                                <span>📦</span>
                                Update Stock
                            </button>
                        }
                        <button type="button" class="btn btn-danger" onclick="deleteProduct(@Model.Id)" title="Delete Product">
                            <span>🗑️</span>
                            Delete Product
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Sections -->
        <div class="details-sections">
            <!-- Description -->
            <div class="details-section">
                <h2 class="section-title">Product Description</h2>
                <div class="description-content">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Html.Raw(Model.Description.Replace("\n", "<br>"))
                    }
                    else
                    {
                        <p class="text-muted">No description available for this product.</p>
                    }
                </div>
            </div>

            <!-- Specifications -->
            <div class="details-section">
                <h2 class="section-title">Product Information</h2>
                <div class="specifications-grid">
                    <div class="spec-item">
                        <span class="spec-label">Product ID:</span>
                        <span class="spec-value">@Model.Id</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Category:</span>
                        <span class="spec-value">@(Model.Category?.Name ?? "Uncategorized")</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Listing Type:</span>
                        <span class="spec-value">@(Model.IsAuction == true ? "Auction" : "Buy It Now")</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Status:</span>
                        <span class="spec-value">@(Model.Status ?? "Active")</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Seller ID:</span>
                        <span class="spec-value">@(Model.SellerId?.ToString() ?? "N/A")</span>
                    </div>
                    @if (Model.Seller != null)
                    {
                        <div class="spec-item">
                            <span class="spec-label">Seller:</span>
                            <span class="spec-value">@Model.Seller.Username</span>
                        </div>
                    }
                    @if (Model.IsAuction == true && Model.AuctionEndTime.HasValue)
                    {
                        <div class="spec-item">
                            <span class="spec-label">Auction End:</span>
                            <span class="spec-value">@Model.AuctionEndTime.Value.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">Time Remaining:</span>
                            <span class="spec-value">
                                @{
                                    var timeRemaining = Model.AuctionEndTime.Value - DateTime.Now;
                                    if (timeRemaining.TotalSeconds > 0)
                                    {
                                        @($"{timeRemaining.Days}d {timeRemaining.Hours}h {timeRemaining.Minutes}m")
                                    }
                                    else
                                    {
                                        <span style="color: #dc3545;">Auction Ended</span>
                                    }
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="details-section">
                <div class="reviews-header">
                    <h2 class="section-title">Customer Reviews</h2>
                    <div class="reviews-stats">
                        <div class="average-rating">
                            <span class="average-number">@averageRating.ToString("F1")</span>
                            <div class="stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star @(i <= averageRating ? "" : "empty")">★</span>
                                }
                            </div>
                        </div>
                        <span class="rating-text">Based on @totalReviews @(totalReviews == 1 ? "review" : "reviews")</span>
                    </div>
                </div>

                @if (reviews.Any())
                {
                    <div class="reviews-list">
                        @foreach (var review in reviews.Take(10))
                        {
                            <div class="review-item">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <div class="reviewer-avatar">
                                            @(review.Reviewer?.Username?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div>
                                            <div class="reviewer-name">@(review.Reviewer?.Username ?? "Anonymous")</div>
                                            <div class="review-date">@(review.CreatedAt?.ToString("MMM dd, yyyy") ?? "")</div>
                                        </div>
                                    </div>
                                    <div class="review-rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="star @(i <= (review.Rating ?? 0) ? "" : "empty")">★</span>
                                        }
                                    </div>
                                </div>
                                <div class="review-content">
                                    @(review.Comment ?? "No comment provided.")
                                </div>
                            </div>
                        }
                    </div>


                    @if (totalReviews > 10)
                    {
                        <div style="text-align: center; margin-top: 1.5rem;">
                            <button class="btn btn-secondary" onclick="loadMoreReviews()">
                                Load More Reviews (@(totalReviews - 10) remaining)
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="no-reviews">
                        <p>No reviews yet for this product.</p>
                        <p>Be the first to share your experience!</p>
                    </div>
                }
            </div>
        </div>

        <!-- Related Products -->
        @if (relatedProducts.Any())
        {
            <div class="related-products">
                <div class="details-section">
                    <h2 class="section-title">Related Products</h2>
                    <div class="related-grid">
                        @foreach (var relatedProduct in relatedProducts.Take(4))
                        {
                            <div class="related-item">
                                <a href="@Url.Action("Details", new { id = relatedProduct.Id })">
                                    @{
                                        var relatedImageUrls = !string.IsNullOrEmpty(relatedProduct.Images) ? relatedProduct.Images.Split(',').Select(img => img.Trim()).ToList() : new List<string>();
                                        var relatedMainImage = relatedImageUrls.FirstOrDefault();
                                    }
                                    @if (!string.IsNullOrEmpty(relatedMainImage))
                                    {
                                        <img src="@relatedMainImage" alt="@relatedProduct.Title" class="related-image">
                                    }
                                    else
                                    {
                                        <div class="related-image" style="background: #f8f9fa; display: flex; align-items: center; justify-content: center; color: #6c757d;">
                                            📷 No Image
                                        </div>
                                    }
                                </a>
                                <div class="related-info">
                                    <h4 class="related-title">
                                        <a href="@Url.Action("Details", new { id = relatedProduct.Id })" style="text-decoration: none; color: inherit;">
                                            @relatedProduct.Title
                                        </a>
                                    </h4>
                                    <div class="related-price">$@(relatedProduct.Price?.ToString("N2") ?? "0.00")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Edit Stock Modal -->
    <div id="editStockModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Update Stock Quantity</h3>
                <span class="close" onclick="closeModal('editStockModal')">&times;</span>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="newStock">New Stock Quantity:</label>
                    <input type="number" id="newStock" class="form-control" min="0" />
                    <small class="form-help">Enter the new quantity for this product</small>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('editStockModal')">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="updateStock()">Update Stock</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Delete Product</h3>
                <span class="close" onclick="closeModal('deleteModal')">&times;</span>
            </div>
            <div class="modal-body">
                <p class="delete-warning">Are you sure you want to delete this product? This action cannot be undone.</p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-primary" onclick="closeModal('deleteModal')">Cancel</button>
                    <form id="deleteForm" action="@Url.Action("Delete", new { id = Model.Id })" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete Product</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function changeMainImage(imageSrc) {
            document.getElementById('mainImage').src = imageSrc;
            
            // Update active thumbnail
            document.querySelectorAll('.thumbnail').forEach(thumb => {
                thumb.classList.remove('active');
            });
            event.target.classList.add('active');
        }

        function pauseListing(productId) {
            if (confirm('Are you sure you want to pause this listing?')) {
                // Implementation for pausing listing
                fetch(`/Listing/Pause/${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to pause listing');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred');
                });
            }
        }

        function activateListing(productId) {
            if (confirm('Are you sure you want to activate this listing?')) {
                // Implementation for activating listing
                fetch(`/Listing/Activate/${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to activate listing');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred');
                });
            }
        }

        function loadMoreReviews() {
            // Implementation for loading more reviews
            console.log('Load more reviews functionality to be implemented');
        }

        let currentProductId = @Model.Id;

        function editStock(productId, currentStock) {
            currentProductId = productId;
            document.getElementById('newStock').value = currentStock;
            document.getElementById('editStockModal').style.display = 'flex';
        }

        function updateStock() {
            const newStock = document.getElementById('newStock').value;
            if (newStock === '' || newStock < 0) {
                alert('Please enter a valid stock quantity');
                return;
            }

            // Get CSRF token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/Listing/UpdateInventory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    productId: currentProductId,
                    quantity: parseInt(newStock)
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Failed to update stock: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating stock');
            });

            closeModal('editStockModal');
        }

        function deleteProduct(productId) {
            // Show delete confirmation modal
            document.getElementById('deleteModal').style.display = 'flex';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        }

        // Handle delete form submission
        document.addEventListener('DOMContentLoaded', function() {
            const deleteForm = document.getElementById('deleteForm');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function(e) {
                    // Remove the additional confirmation - modal is already enough confirmation
                    // User has already confirmed in the modal, so proceed with deletion
                    console.log('Proceeding with product deletion...');
                });
            }
        });
    </script>
</body>
</html>