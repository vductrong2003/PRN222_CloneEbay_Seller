<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Performance | Seller Hub | eBay</title>
</head>
<body>
    
    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs với Dropdown Menu -->
            <div class="tabs-container">
                <!-- Tab thông thường -->
                <a href="/Seller/Overview" class="tab active">Overview</a>

                <!-- Tab Orders có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Orders</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">All orders</a>
                        <a href="#" class="dropdown-item">Awaiting payment</a>
                        <a href="#" class="dropdown-item">Awaiting shipment</a>
                        <a href="#" class="dropdown-item">Paid and shipped</a>
                        <a href="#" class="dropdown-item">Cancellations</a>
                        <a href="#" class="dropdown-item">Returns</a>
                        <a href="#" class="dropdown-item">Requests and disputes</a>
                        <a href="#" class="dropdown-item">Shipping labels</a>
                    </div>
                </div>

                <!-- Tab Listings có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Listings</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Create listing</a>
                        <a href="#" class="dropdown-item">Active</a>
                        <a href="#" class="dropdown-item">Unsold</a>
                        <a href="#" class="dropdown-item">Drafts</a>
                        <a href="#" class="dropdown-item">Scheduled</a>
                        <a href="#" class="dropdown-item">Ended</a>
                    </div>
                </div>

                <!-- Tab Marketing có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                        <a href="#" class="dropdown-item">Email marketing</a>
                    </div>
                </div>

                <!-- Tab thông thường -->
                <a href="/Seller/Store" class="tab">Store</a>

                <!-- Tab Performance có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Performance</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Summary</a>
                        <a href="#" class="dropdown-item">Seller level</a>
                        <a href="#" class="dropdown-item">Sales</a>
                        <a href="#" class="dropdown-item">Traffic</a>
                    </div>
                </div>

                <!-- Tab Payments có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                        <a href="#" class="dropdown-item">Transaction history</a>
                    </div>
                </div>

                <!-- Tab thông thường khác -->
                <a href="#" class="tab">Research</a>

                <!-- Tab Reports có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                        <a href="#" class="dropdown-item">Performance reports</a>
                    </div>
                </div>

                <!-- Link bên phải -->
                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        <!-- Performance Content -->
        <div class="performance-container">
            <!-- Sidebar -->
            <aside class="sidebar">
                <ul class="sidebar-menu">
                    <li><a href="#" class="active">Summary</a></li>
                    <li><a href="#">Seller level</a></li>
                    <li><a href="#">Sales</a></li>
                    <li><a href="#">Selling costs</a></li>
                    <li><a href="#">Traffic</a></li>
                    <li><a href="#">Impressions</a></li>
                </ul>
            </aside>

            <!-- Main content -->
            <main class="main-content">
                <h2 class="page-title">Understand your business performance</h2>

                <!-- Sales perspective card -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Sales perspective last 31 days (total)</span>
                    </div>

                    <div class="stats-row">
                        <div class="stat-column">
                            <div class="percent-positive">+ 9%</div>
                            <div class="stat-label">Compared to prior period</div>
                        </div>
                    </div>

                    <div class="sales-summary">
                        Great! Your sales are on the upswing. You're obviously doing something right - keep up the good work!
                        <span class="link">Show less ▲</span>
                    </div>

                    <div class="period-comparison">
                        <div class="comparison-column">
                            <div class="comparison-title">Compared to prior 31 days</div>
                            <div class="comparison-value percent-negative">-9%</div>
                            <div class="bar-container">
                                <div class="bar" style="height: 40px;"></div>
                            </div>
                            <div class="comparison-label">You</div>
                        </div>
                        <div class="comparison-column">
                            <div class="comparison-title">Compared to last year</div>
                            <div class="comparison-value percent-positive">+2%</div>
                            <div class="bar-container">
                                <div class="bar gray" style="height: 60px;"></div>
                            </div>
                            <div class="comparison-label">Similar</div>
                        </div>
                        <div class="comparison-column">
                            <div class="comparison-title"></div>
                            <div class="comparison-value percent-positive">+3%</div>
                            <div class="bar-container">
                                <div class="bar" style="height: 60px;"></div>
                            </div>
                            <div class="comparison-label">You</div>
                        </div>
                        <div class="comparison-column">
                            <div class="comparison-title"></div>
                            <div class="comparison-value percent-positive">+6%</div>
                            <div class="bar-container">
                                <div class="bar gray" style="height: 70px;"></div>
                            </div>
                            <div class="comparison-label">Related</div>
                        </div>
                    </div>

                    <div class="footnote">
                        Market comparison based on sales in Cell Phones & Smartphones and Video Games. Most of your active listings are in those categories.
                    </div>
                </div>

                <!-- Sales Chart -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Sales</span>
                        <span class="arrow-link">›</span>
                    </div>

                    <div class="stats-row">
                        <div class="stat-column">
                            <div class="stat-label">Today</div>
                            <div class="stat-value">£1,009.12</div>
                        </div>
                        <div class="stat-column">
                            <div class="stat-label">Last 7 days</div>
                            <div class="stat-value">£5,651.44</div>
                        </div>
                        <div class="stat-column">
                            <div class="stat-label">Last 31 days</div>
                            <div class="stat-value">£19,211.08</div>
                        </div>
                        <div class="stat-column">
                            <div class="stat-label">Last 90 days</div>
                            <div class="stat-value">£139,099.12</div>
                        </div>
                    </div>

                    <div class="chart-container">
                        <div class="y-axis">
                            <div class="y-axis-label">£3,000</div>
                            <div class="y-axis-label">£2,500</div>
                            <div class="y-axis-label">£2,000</div>
                            <div class="y-axis-label">£1,500</div>
                            <div class="y-axis-label">£1,000</div>
                        </div>
                        <div class="chart">
                            <div class="chart-bar" style="height: 20%;">
                                <div class="x-axis-label">30 May</div>
                            </div>
                            <div class="chart-bar" style="height: 45%;"></div>
                            <div class="chart-bar" style="height: 30%;"></div>
                            <div class="chart-bar" style="height: 40%;"></div>
                            <div class="chart-bar" style="height: 25%;"></div>
                            <div class="chart-bar" style="height: 55%;"></div>
                            <div class="chart-bar" style="height: 35%;"></div>
                            <div class="chart-bar" style="height: 60%;"></div>
                            <div class="chart-bar" style="height: 70%;">
                                <div class="x-axis-label">8 Jun</div>
                            </div>
                            <div class="chart-bar" style="height: 45%;"></div>
                            <div class="chart-bar" style="height: 30%;"></div>
                            <div class="chart-bar" style="height: 20%;"></div>
                            <div class="chart-bar" style="height: 50%;"></div>
                            <div class="chart-bar" style="height: 75%;"></div>
                            <div class="chart-bar" style="height: 45%;"></div>
                            <div class="chart-bar" style="height: 50%;">
                                <div class="x-axis-label">15 Jun</div>
                            </div>
                            <div class="chart-bar" style="height: 60%;"></div>
                            <div class="chart-bar" style="height: 55%;"></div>
                            <div class="chart-bar" style="height: 30%;"></div>
                            <div class="chart-bar" style="height: 40%;"></div>
                            <div class="chart-bar" style="height: 25%;"></div>
                            <div class="chart-bar" style="height: 35%;"></div>
                            <div class="chart-bar" style="height: 40%;">
                                <div class="x-axis-label">22 Jun</div>
                            </div>
                            <div class="chart-bar" style="height: 50%;"></div>
                            <div class="chart-bar" style="height: 55%;"></div>
                            <div class="chart-bar" style="height: 30%;"></div>
                            <div class="chart-bar" style="height: 45%;"></div>
                        </div>
                    </div>

                    <div class="chart-footnote">
                        30 May - 23 Jun (1am)
                    </div>
                </div>

                <!-- Bottom section: Selling costs and traffic -->
                <div style="display: flex; gap: 20px;">
                    <!-- Selling Costs -->
                    <div class="card" style="flex: 1;">
                        <div class="card-header">
                            <span class="card-title">Selling costs</span>
                            <span class="arrow-link">›</span>
                        </div>

                        <div style="padding: 16px; text-align: right; border-bottom: 1px solid #e5e5e5;">
                            <div style="font-weight: 700;">Total sales: £19,211.08</div>
                        </div>

                        <div class="selling-costs-grid">
                            <div class="donut-container">
                                <div class="donut-chart">
                                    <div class="donut-center">
                                        <div class="donut-value">£2,497</div>
                                        <div class="donut-label">Total selling costs</div>
                                        <div class="donut-label">13% of total sales</div>
                                    </div>
                                </div>
                            </div>

                            <div class="fees-breakdown">
                                <div class="fee-item">
                                    <div><span class="fee-color color-orange"></span> eBay fees</div>
                                    <div>(£1,652.66)</div>
                                </div>
                                <div class="fee-item">
                                    <div><span class="fee-color color-red"></span> Listing fees</div>
                                    <div>(£532.30)</div>
                                </div>
                                <div class="fee-item">
                                    <div><span class="fee-color color-purple"></span> Final value fees</div>
                                    <div>(£1,225.77)</div>
                                </div>
                                <div class="fee-item">
                                    <div><span class="fee-color color-blue"></span> Subscription fees</div>
                                    <div>(£200.00)</div>
                                </div>
                                <div class="fee-item">
                                    <div>Fee credits</div>
                                    <div>£88.50</div>
                                </div>
                                <div class="fee-item">
                                    <div>Discounts</div>
                                    <div>£11.40</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Traffic Metrics -->
                    <div class="traffic-metrics">
                        <div class="traffic-card">
                            <div class="card-header">
                                <span class="card-title">Traffic</span>
                                <span class="arrow-link">›</span>
                            </div>
                            <div class="traffic-stats">
                                <div class="traffic-value">743,344</div>
                                <div>
                                    <span class="percent-positive">+11%</span>
                                    <span>Compared to prior 31 days</span>
                                </div>
                            </div>
                        </div>

                        <div class="traffic-card">
                            <div class="card-header">
                                <span class="card-title">Listing impressions</span>
                                <span class="arrow-link">›</span>
                            </div>
                            <div class="traffic-stats">
                                <div class="traffic-value">743,344</div>
                                <div>
                                    <span class="percent-positive">+11%</span>
                                </div>
                            </div>
                        </div>

                        <div class="traffic-card">
                            <div class="card-header">
                                <span class="card-title">Click-through rate</span>
                                <span class="arrow-link">›</span>
                            </div>
                            <div class="traffic-stats">
                                <div class="traffic-value">7.0%</div>
                                <div>
                                    <span class="percent-positive">+3 pts</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    
</body>
</html>