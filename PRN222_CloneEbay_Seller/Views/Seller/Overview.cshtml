<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overview | Seller Hub | eBay</title>
</head>
<body>



    <!-- Seller Hub Header -->
    <div class="container">
        <div class="seller-hub-header">
            <div class="seller-hub-title">
                <h1>Seller Hub</h1>
                <span class="seller-id">(2,431)</span>
            </div>

            <!-- Navigation Tabs với Dropdown Menu -->
            <div class="tabs-container">
                <!-- Tab thông thường -->
                <a href="/Seller/Overview" class="tab active">Overview</a>

                <!-- Tab Orders có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Orders" class="tab has-dropdown">Orders</a>
                    <div class="dropdown-menu">
                        <a href="/Orders?status=all" class="dropdown-item">All orders</a>
                        <a href="/Orders?status=awaiting-payment" class="dropdown-item">Awaiting payment</a>
                        <a href="/Orders?status=awaiting-shipment" class="dropdown-item">Awaiting shipment</a>
                        <a href="/Orders?status=shipped" class="dropdown-item">Paid and shipped</a>
                        <a href="/Orders?status=cancelled" class="dropdown-item">Cancellations</a>
                        <a href="/Orders?status=returns" class="dropdown-item">Returns</a>
                        <a href="#" class="dropdown-item">Requests and disputes</a>
                        <a href="#" class="dropdown-item">Shipping labels</a>
                    </div>
                </div>

                <!-- Tab Listings có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Listings</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Create listing</a>
                        <a href="#" class="dropdown-item">Active</a>
                        <a href="#" class="dropdown-item">Unsold</a>
                        <a href="#" class="dropdown-item">Drafts</a>
                        <a href="#" class="dropdown-item">Scheduled</a>
                        <a href="#" class="dropdown-item">Ended</a>
                    </div>
                </div>

                <!-- Tab Marketing có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Marketing</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Promotions</a>
                        <a href="#" class="dropdown-item">Advertising</a>
                        <a href="#" class="dropdown-item">Email marketing</a>
                    </div>
                </div>

                <!-- Tab thông thường -->
                <a href="/Seller/Store" class="tab">Store</a>

                <!-- Tab Performance có dropdown -->
                <div class="tab-wrapper">
                    <a href="/Seller/Performance" class="tab has-dropdown">Performance</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Summary</a>
                        <a href="#" class="dropdown-item">Seller level</a>
                        <a href="#" class="dropdown-item">Sales</a>
                        <a href="#" class="dropdown-item">Traffic</a>
                    </div>
                </div>

                <!-- Tab Payments có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Payments</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Overview</a>
                        <a href="#" class="dropdown-item">Payouts</a>
                        <a href="#" class="dropdown-item">Transaction history</a>
                    </div>
                </div>

                <!-- Tab thông thường khác -->
                <a href="#" class="tab">Research</a>

                <!-- Tab Reports có dropdown -->
                <div class="tab-wrapper">
                    <a href="#" class="tab has-dropdown">Reports</a>
                    <div class="dropdown-menu">
                        <a href="#" class="dropdown-item">Sales reports</a>
                        <a href="#" class="dropdown-item">Traffic reports</a>
                        <a href="#" class="dropdown-item">Performance reports</a>
                    </div>
                </div>

                <!-- Link bên phải -->
                <div class="right-nav">
                    <a href="#">Messages (129)</a>
                    <a href="#">Comments 7</a>
                    <a href="#">Opt out</a>
                </div>
            </div>
        </div>

        <!-- Overview Cards -->
        <div class="cards-grid">
            <div class="card">
                <div class="card-title">Unread messages</div>
                <div class="card-value">149</div>
            </div>
            <div class="card">
                <div class="card-title">Awaiting shipment</div>
                <div class="card-value">9</div>
            </div>
            <div class="card">
                <div class="card-title">Sales (31 days)</div>
                <div class="card-value">$6,164.46</div>
            </div>
            <div class="card">
                <div class="card-title">Seller level forecast</div>
                <div class="card-value">Above Standard</div>
            </div>
        </div>

        <!-- Content Panels -->
        <div class="content-grid">
            <!-- Feedback Panel -->
            <div class="panel">
                <div class="panel-header">
                    <h3 class="panel-title">Feedback</h3>
                    <div class="panel-stats">
                        <span class="panel-stats-number">(2,431)</span>
                        92.2%
                        <span class="arrow-link">›</span>
                    </div>
                </div>

                <div class="feedback-period">Last 30 days</div>
                <div class="feedback-stats">
                    <div class="feedback-stat">
                        <div class="feedback-icon feedback-positive">+</div>
                        <span><strong>20</strong> Positive</span>
                    </div>
                    <div class="feedback-stat">
                        <div class="feedback-icon feedback-neutral">○</div>
                        <span><strong>0</strong> Neutral</span>
                    </div>
                    <div class="feedback-stat">
                        <div class="feedback-icon feedback-negative">-</div>
                        <span><strong>0</strong> Negative</span>
                    </div>
                </div>

                <div class="feedback-items">
                    <div class="feedback-header">Most recent</div>

                    <div class="feedback-item">
                        <div class="feedback-content">
                            <div class="feedback-icon feedback-positive">+</div>
                            <div class="feedback-text">As described.</div>
                        </div>
                        <div class="feedback-date">Apr 28</div>
                    </div>

                    <div class="feedback-item">
                        <div class="feedback-content">
                            <div class="feedback-icon feedback-positive">+</div>
                            <div class="feedback-text">Exactly what was advertised and arrived on time.</div>
                        </div>
                        <div class="feedback-date">Apr 27</div>
                    </div>

                    <div class="feedback-item">
                        <div class="feedback-content">
                            <div class="feedback-icon feedback-positive">+</div>
                            <div class="feedback-text">Just what I was looking for. Fits my *** perfectly. Thanks</div>
                        </div>
                        <div class="feedback-date">Apr 26</div>
                    </div>
                </div>

                <div class="feedback-links">
                    <div>Feedback for buyers</div>
                    <a href="#">Leave feedback</a>
                    <a href="#">Manage automated feedback</a>
                </div>
            </div>

            <!-- Tasks Panel -->
            <div class="panel">
                <div class="panel-header">
                    <h3 class="panel-title">Tasks</h3>
                </div>

                <div class="task-list">
                    <div class="task-item">
                        <span class="task-name">Print labels and ship</span>
                        <span class="task-count">9</span>
                    </div>
                    <div class="task-item">
                        <span class="task-name">Overdue</span>
                        <span class="task-count">1</span>
                    </div>
                    <div class="task-item">
                        <span class="task-name">Read unread messages from eBay members</span>
                        <span class="task-count">19</span>
                    </div>
                </div>

                <div class="task-header">Suggested actions</div>
                <div class="task-list">
                    <div class="task-item">
                        <span class="task-name">Listings eligible to send offers</span>
                        <span class="task-count">24</span>
                    </div>
                    <div class="task-item">
                        <span class="task-name">Add recommended item specifics</span>
                        <span class="task-count">1100</span>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>
</html>