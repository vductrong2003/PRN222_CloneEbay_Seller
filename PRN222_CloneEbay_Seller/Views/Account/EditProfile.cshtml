@model PRN222_CloneEbay_Seller.Models.UpdateProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <!-- Status Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="status-message status-success">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="status-message status-error">
            @TempData["Error"]
        </div>
    }

    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-section">
            <h2 class="page-title">Edit Profile</h2>
            <div class="header-actions">
                <a href="@Url.Action("Profile")" class="btn-secondary">
                    <span class="icon">←</span>
                    Back to Profile
                </a>
            </div>
        </div>
    </div>

    <div class="edit-profile-container">
        <div class="edit-profile-card">
            <form asp-action="EditProfile" method="post" class="profile-form">
                @Html.AntiForgeryToken()
                
                <div class="form-section">
                    <h3 class="section-title">Basic Information</h3>
                    
                    <div class="form-group">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" placeholder="Enter your username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                        <div class="form-help">
                            <small>Your username is visible to other users and must be unique.</small>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter your email address" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-help">
                            <small>This email will be used for login and notifications.</small>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="AvatarUrl" class="form-label">Avatar URL</label>
                        <input asp-for="AvatarUrl" class="form-control" placeholder="https://example.com/avatar.jpg" />
                        <span asp-validation-for="AvatarUrl" class="text-danger"></span>
                        <div class="form-help">
                            <small>Enter a URL to an image for your profile picture.</small>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">
                        <span class="icon">💾</span>
                        Save Changes
                    </button>
                    <a href="@Url.Action("Profile")" class="btn-secondary">
                        <span class="icon">✖️</span>
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Avatar Preview -->
        <div class="avatar-preview-card">
            <h3 class="section-title">Avatar Preview</h3>
            <div class="avatar-preview-container">
                <div class="avatar-preview" id="avatarPreview">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar Preview" class="preview-image" id="previewImage" />
                    }
                    else
                    {
                        <div class="preview-placeholder" id="previewPlaceholder">
                            <span class="placeholder-initial">@(Model.Username?.Substring(0, 1).ToUpper() ?? "U")</span>
                        </div>
                    }
                </div>
                <p class="preview-note">This is how your avatar will appear to other users.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .edit-profile-container {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .edit-profile-card, .avatar-preview-card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        height: fit-content;
    }

    .profile-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #2c3e50;
        margin: 0 0 1rem 0;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #e9ecef;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.95rem;
    }

    .form-control {
        padding: 0.75rem;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: white;
    }

    .form-control:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
    }

    .form-help small {
        color: #6c757d;
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
    }

    .avatar-preview-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .avatar-preview {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #007bff;
        background: white;
    }

    .preview-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .preview-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #007bff, #0056b3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .placeholder-initial {
        font-size: 2.5rem;
        font-weight: 700;
        color: white;
    }

    .preview-note {
        text-align: center;
        color: #6c757d;
        font-size: 0.9rem;
        margin: 0;
    }

    
</style>

<script>
    // Avatar URL preview
    document.addEventListener('DOMContentLoaded', function() {
        const avatarInput = document.querySelector('input[name="AvatarUrl"]');
        const previewImage = document.getElementById('previewImage');
        const previewPlaceholder = document.getElementById('previewPlaceholder');
        const usernameInput = document.querySelector('input[name="Username"]');

        function updateAvatarPreview() {
            const avatarUrl = avatarInput.value.trim();
            const username = usernameInput.value.trim();
            
            if (avatarUrl) {
                // Test if URL is valid by creating a temporary image
                const tempImg = new Image();
                tempImg.onload = function() {
                    // URL is valid, show image
                    if (previewImage) {
                        previewImage.src = avatarUrl;
                        previewImage.style.display = 'block';
                    } else {
                        // Create new image element
                        const newImg = document.createElement('img');
                        newImg.src = avatarUrl;
                        newImg.alt = 'Avatar Preview';
                        newImg.className = 'preview-image';
                        newImg.id = 'previewImage';
                        
                        const avatarPreview = document.getElementById('avatarPreview');
                        avatarPreview.innerHTML = '';
                        avatarPreview.appendChild(newImg);
                    }
                    
                    if (previewPlaceholder) {
                        previewPlaceholder.style.display = 'none';
                    }
                };
                tempImg.onerror = function() {
                    // URL is invalid, show placeholder
                    showPlaceholder(username);
                };
                tempImg.src = avatarUrl;
            } else {
                // No URL, show placeholder
                showPlaceholder(username);
            }
        }

        function showPlaceholder(username) {
            if (previewImage) {
                previewImage.style.display = 'none';
            }
            
            if (!previewPlaceholder) {
                // Create placeholder
                const newPlaceholder = document.createElement('div');
                newPlaceholder.className = 'preview-placeholder';
                newPlaceholder.id = 'previewPlaceholder';
                
                const avatarPreview = document.getElementById('avatarPreview');
                avatarPreview.innerHTML = '';
                avatarPreview.appendChild(newPlaceholder);
            }
            
            const placeholderElement = document.getElementById('previewPlaceholder');
            if (placeholderElement) {
                placeholderElement.style.display = 'flex';
                placeholderElement.innerHTML = `<span class="placeholder-initial">${(username || 'U').charAt(0).toUpperCase()}</span>`;
            }
        }

        // Update preview when inputs change
        if (avatarInput) {
            avatarInput.addEventListener('input', updateAvatarPreview);
        }
        
        if (usernameInput) {
            usernameInput.addEventListener('input', updateAvatarPreview);
        }
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}