@model PRN222_CloneEbay_Seller.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | Seller Hub | eBay</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <div class="container">
        <!-- Status Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="status-message status-success">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="status-message status-error">
                @TempData["Error"]
            </div>
        }

        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title-section">
                <h2 class="page-title">My Profile</h2>
                <div class="header-actions">
                    <a href="@Url.Action("EditProfile")" class="btn-primary">
                        <span class="icon">✏️</span>
                        Edit Profile
                    </a>
                    <a href="@Url.Action("ChangePassword")" class="btn-secondary">
                        <span class="icon">🔐</span>
                        Change Password
                    </a>
                </div>
            </div>
        </div>

        <div class="profile-container">
            <!-- Left Column - Profile Info -->
            <div class="profile-main">
                <div class="profile-card">
                    <div class="profile-header">
                        <div class="avatar-section">
                            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                            {
                                <img src="@Model.AvatarUrl" alt="@Model.Username" class="profile-avatar" />
                            }
                            else
                            {
                                <div class="profile-avatar-placeholder">
                                    <span class="avatar-initial">@(Model.Username?.Substring(0, 1).ToUpper() ?? "U")</span>
                                </div>
                            }
                        </div>
                        <div class="profile-info">
                            <h3 class="profile-name">@Model.Username</h3>
                            <p class="profile-email">@Model.Email</p>
                            <div class="profile-badges">
                                <span class="role-badge @(Model.Role?.ToLower())">@Model.Role</span>
                                <span class="status-badge @(Model.Status?.ToLower())">@Model.Status</span>
                            </div>
                        </div>
                    </div>

                    <div class="profile-details">
                        <div class="detail-row">
                            <span class="detail-label">User ID:</span>
                            <span class="detail-value">#@Model.Id</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Role:</span>
                            <span class="detail-value">@(Model.Role ?? "User")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Account Status:</span>
                            <span class="detail-value status-@(Model.Status?.ToLower() ?? "unknown")">@(Model.Status ?? "Unknown")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Member Since:</span>
                            <span class="detail-value">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                        @if (Model.LastLoginAt.HasValue)
                        {
                            <div class="detail-row">
                                <span class="detail-label">Last Login:</span>
                                <span class="detail-value">@Model.LastLoginAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")</span>
                            </div>
                        }
                    </div>
                </div>

                
        </div>
    </div>

    <style>
        /* Profile Styles */
        .profile-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .profile-card, .store-card, .stats-card, .actions-card {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #e9ecef;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #007bff;
        }

        .profile-avatar-placeholder {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, #007bff, #0056b3);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 4px solid #007bff;
        }

        .avatar-initial {
            font-size: 3rem;
            font-weight: 700;
            color: white;
        }

        .profile-name {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
            margin: 0 0 0.5rem 0;
        }

        .profile-email {
            font-size: 1.1rem;
            color: #6c757d;
            margin: 0 0 1rem 0;
        }

        .profile-badges {
            display: flex;
            gap: 0.5rem;
        }

        .role-badge, .status-badge {
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .role-badge.seller {
            background: #28a745;
            color: white;
        }

        .role-badge.user {
            background: #17a2b8;
            color: white;
        }

        .status-badge.active {
            background: #d4edda;
            color: #155724;
        }

        .profile-details {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f8f9fa;
        }

        .detail-label {
            font-weight: 600;
            color: #495057;
        }

        .detail-value {
            color: #2c3e50;
        }

        .detail-value.status-active {
            color: #28a745;
            font-weight: 600;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e9ecef;
        }

        .card-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin: 0;
        }

        .btn-link {
            color: #007bff;
            text-decoration: none;
            font-weight: 500;
        }

        .btn-link:hover {
            text-decoration: underline;
        }

        .store-logo {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .stat-icon {
            font-size: 1.5rem;
            width: 40px;
            text-align: center;
        }

        .stat-number {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2c3e50;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 0.25rem;
        }

        .action-links {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .action-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem;
            text-decoration: none;
            color: #495057;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .action-link:hover {
            background: #f8f9fa;
            color: #007bff;
            transform: translateX(4px);
        }

        .action-icon {
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }

        .action-text {
            font-weight: 500;
        }

        
    </style>
</body>
</html>