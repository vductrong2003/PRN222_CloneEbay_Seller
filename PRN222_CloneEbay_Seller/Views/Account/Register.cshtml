@model PRN222_CloneEbay_Seller.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create eBay Seller Account";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card register-card">
        <div class="auth-header">
            <h1 class="auth-title">
                <i class="fas fa-store"></i>
                Create Seller Account
            </h1>
            <p class="auth-subtitle">Start selling on eBay and grow your business</p>
        </div>

        <div class="registration-benefits">
            <div class="benefit-item">
                <i class="fas fa-chart-line"></i>
                <span>Track your performance</span>
            </div>
            <div class="benefit-item">
                <i class="fas fa-shipping-fast"></i>
                <span>Manage orders & shipping</span>
            </div>
            <div class="benefit-item">
                <i class="fas fa-dollar-sign"></i>
                <span>Optimize your listings</span>
            </div>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            
            <div class="form-row">
                <div class="form-group half-width">
                    <label asp-for="FirstName" class="form-label">
                        <i class="fas fa-user"></i>
                        First Name
                    </label>
                    <input asp-for="FirstName" class="form-control" placeholder="Enter your first name" autocomplete="given-name" autofocus />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group half-width">
                    <label asp-for="LastName" class="form-label">
                        <i class="fas fa-user"></i>
                        Last Name
                    </label>
                    <input asp-for="LastName" class="form-control" placeholder="Enter your last name" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Username" class="form-label">
                    <i class="fas fa-at"></i>
                    Username
                </label>
                <input asp-for="Username" class="form-control" placeholder="Choose a unique username" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
                <small class="form-text">This will be your unique identifier on eBay</small>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    <i class="fas fa-envelope"></i>
                    Email Address
                </label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email address" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <small class="form-text">We'll send your login credentials to this email</small>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber" class="form-label">
                    <i class="fas fa-phone"></i>
                    Phone Number (Optional)
                </label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Enter your phone number" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="password-info-box">
                <h4><i class="fas fa-key"></i> Password Information</h4>
                <p>For security, we'll generate a secure password and send it to your email. You can change it after logging in.</p>
                <ul>
                    <li><i class="fas fa-check"></i> 8 characters long</li>
                    <li><i class="fas fa-check"></i> Contains uppercase & lowercase letters</li>
                    <li><i class="fas fa-check"></i> Contains numbers</li>
                    <li><i class="fas fa-check"></i> Secure & randomly generated</li>
                </ul>
            </div>

            

            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

            <button type="submit" class="btn btn-primary btn-register">
                <i class="fas fa-user-plus"></i>
                Create Account
            </button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login" class="btn btn-outline-primary btn-login-link">
                <i class="fas fa-sign-in-alt"></i>
                Sign In
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Real-time username validation
        document.getElementById('Username').addEventListener('input', function() {
            const username = this.value;
            const regex = /^[a-zA-Z0-9_]+$/;
            
            if (username && !regex.test(username)) {
                this.classList.add('is-invalid');
            } else {
                this.classList.remove('is-invalid');
            }
        });

        // Form validation
        document.querySelector('.auth-form').addEventListener('submit', function(e) {
            const agreeToTerms = document.getElementById('agreeToTerms');
            
            if (!agreeToTerms.checked) {
                e.preventDefault();
                agreeToTerms.focus();
                alert('Please agree to the Terms and Conditions to continue.');
                return false;
            }
        });

        // Auto-focus first input
        document.addEventListener('DOMContentLoaded', function() {
            const firstInput = document.querySelector('input[autofocus]');
            if (firstInput) {
                firstInput.focus();
            }
        });
    </script>
}