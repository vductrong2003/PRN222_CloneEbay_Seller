@model IEnumerable<PRN222_CloneEbay_Seller.Models.Product>

@{
    ViewData["Title"] = "Product Management";
}

<!-- Add a reference to an icon library, for example, Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Custom styles for better alignment and spacing */
    .table th, .table td {
        vertical-align: middle;
    }

    .product-image {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 0.25rem;
    }

    .action-buttons a {
        margin: 0 2px;
    }
</style>

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0 text-dark">@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-2"></i>Create New Product
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Image</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Title)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Price)</th>
                        <th scope="col">Category</th>
                        <th scope="col">Listing Type</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <!-- Use a placeholder if no image is available -->
                                <img src="@(string.IsNullOrEmpty(item.Images) ? "https://placehold.co/80x80?text=N/A" : item.Images.Split(',')[0])"
                                     alt="Product Image" class="product-image" />
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Title)</td>
                            <td>@item.Price?.ToString("C")</td>
                            <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                            <td>
                                @if (item.IsAuction == true)
                                {
                                    <span class="badge bg-success">Auction</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">Fixed Price</span>
                                }
                            </td>
                            <td class="text-center action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>